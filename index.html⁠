<!DOCTYPE html>
<html lang="ka">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Royal Casino Simulator</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

:root{
    --bg:#07070d;
    --panel:#10101a;
    --panel2:#171724;
    --gold:#f5c451;
    --gold2:#ffdf7e;
    --red:#e63946;
    --green:#20d68b;
    --text:#fff;
    --muted:#8d8da2;
    --border:rgba(255,255,255,.08);
}

body{
    background:
      radial-gradient(circle at 50% -10%,#30230b 0%,transparent 35%),
      radial-gradient(circle at 100% 50%,#17102d 0%,transparent 30%),
      var(--bg);
    color:var(--text);
    font-family:Arial,Helvetica,sans-serif;
    min-height:100vh;
}

button{
    border:0;
    cursor:pointer;
    color:white;
    font-weight:bold;
}

.app{
    display:flex;
    min-height:100vh;
}

/* SIDEBAR */

.sidebar{
    width:250px;
    background:rgba(12,12,20,.96);
    border-right:1px solid var(--border);
    padding:25px 15px;
    position:fixed;
    left:0;
    top:0;
    bottom:0;
    z-index:20;
}

.logo{
    text-align:center;
    font-size:25px;
    font-weight:900;
    color:var(--gold);
    margin-bottom:35px;
    text-shadow:0 0 20px rgba(245,196,81,.35);
}

.logo span{
    color:white;
}

.nav{
    display:flex;
    flex-direction:column;
    gap:8px;
}

.nav button{
    background:transparent;
    text-align:left;
    padding:14px;
    border-radius:12px;
    color:#aaaabd;
    font-size:15px;
    transition:.2s;
}

.nav button:hover,
.nav button.active{
    background:linear-gradient(90deg,rgba(245,196,81,.16),transparent);
    color:var(--gold);
}

.balanceBox{
    position:absolute;
    bottom:25px;
    left:15px;
    right:15px;
    padding:16px;
    background:linear-gradient(145deg,#191923,#0d0d14);
    border:1px solid var(--border);
    border-radius:16px;
}

.balanceBox small{
    color:var(--muted);
}

.balance{
    color:var(--gold);
    font-size:23px;
    font-weight:900;
    margin-top:6px;
}

/* MAIN */

.main{
    margin-left:250px;
    width:calc(100% - 250px);
    padding:25px;
}

.topbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:15px;
    margin-bottom:25px;
}

.welcome h1{
    font-size:27px;
}

.welcome p{
    color:var(--muted);
    margin-top:5px;
}

.topBalance{
    background:linear-gradient(135deg,#211b0c,#15120b);
    border:1px solid rgba(245,196,81,.25);
    padding:12px 18px;
    border-radius:14px;
    color:var(--gold);
    font-weight:bold;
}

/* PAGES */

.page{
    display:none;
    animation:fade .35s ease;
}

.page.active{
    display:block;
}

@keyframes fade{
    from{opacity:0;transform:translateY(8px)}
    to{opacity:1;transform:translateY(0)}
}

/* CARDS */

.grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.card{
    background:linear-gradient(145deg,rgba(25,25,37,.95),rgba(13,13,20,.95));
    border:1px solid var(--border);
    border-radius:18px;
    padding:20px;
    box-shadow:0 10px 35px rgba(0,0,0,.2);
}

.stat{
    position:relative;
    overflow:hidden;
}

.stat:after{
    content:"";
    position:absolute;
    width:80px;
    height:80px;
    background:var(--gold);
    opacity:.06;
    border-radius:50%;
    right:-25px;
    top:-25px;
}

.stat small{
    color:var(--muted);
}

.stat h2{
    margin-top:8px;
    font-size:25px;
}

.gold{
    color:var(--gold);
}

.green{
    color:var(--green);
}

.red{
    color:var(--red);
}

/* HERO */

.hero{
    margin-top:20px;
    padding:30px;
    border-radius:22px;
    min-height:190px;
    background:
      linear-gradient(90deg,rgba(0,0,0,.8),rgba(0,0,0,.2)),
      radial-gradient(circle at 80% 50%,#6b4710,transparent 35%),
      #17120b;
    border:1px solid rgba(245,196,81,.18);
    position:relative;
    overflow:hidden;
}

.hero h2{
    color:var(--gold);
    font-size:32px;
}

.hero p{
    color:#aaa;
    margin-top:8px;
    max-width:500px;
}

.hero .chips{
    position:absolute;
    right:8%;
    top:25px;
    font-size:90px;
    opacity:.18;
}

/* GAME HEADER */

.gameHeader{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:20px;
}

.gameHeader h2{
    font-size:27px;
}

.backBtn{
    background:#20202d;
    padding:10px 15px;
    border-radius:10px;
}

/* SLOTS */

.slotMachine{
    max-width:850px;
    margin:auto;
}

.slotScreen{
    background:#09090e;
    border:3px solid #5a4417;
    border-radius:25px;
    padding:30px;
    box-shadow:
      0 0 0 5px #19130a,
      0 20px 70px rgba(0,0,0,.5);
}

.reels{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:12px;
}

.reel{
    height:150px;
    border-radius:18px;
    background:linear-gradient(#222231,#0b0b11);
    border:2px solid #39394a;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:80px;
    box-shadow:inset 0 0 30px rgba(0,0,0,.8);
}

.reel.spin{
    animation:spin .15s linear infinite;
}

@keyframes spin{
    0%{transform:translateY(-7px)}
    50%{transform:translateY(7px)}
    100%{transform:translateY(-7px)}
}

.slotControls{
    margin-top:20px;
    display:flex;
    gap:10px;
}

.amountInput{
    flex:1;
    background:#11111a;
    border:1px solid var(--border);
    color:white;
    padding:14px;
    border-radius:12px;
    outline:none;
}

.primary{
    background:linear-gradient(135deg,#f5c451,#b47a16);
    color:#16120a;
    padding:14px 25px;
    border-radius:12px;
    box-shadow:0 5px 20px rgba(245,196,81,.15);
}

.primary:hover{
    transform:translateY(-1px);
}

.result{
    text-align:center;
    min-height:35px;
    margin-top:18px;
    font-weight:bold;
    color:var(--gold);
}

/* ROULETTE */

.rouletteWrap{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:25px;
    align-items:center;
}

.wheel{
    width:330px;
    height:330px;
    margin:auto;
    border-radius:50%;
    border:10px solid #b88a28;
    background:
      conic-gradient(
        #e63946 0deg 30deg,
        #101016 30deg 60deg,
        #e63946 60deg 90deg,
        #101016 90deg 120deg,
        #e63946 120deg 150deg,
        #101016 150deg 180deg,
        #e63946 180deg 210deg,
        #101016 210deg 240deg,
        #e63946 240deg 270deg,
        #101016 270deg 300deg,
        #e63946 300deg 330deg,
        #101016 330deg 360deg
      );
    position:relative;
    box-shadow:0 0 50px rgba(245,196,81,.15);
}

.wheel:after{
    content:"★";
    position:absolute;
    width:85px;
    height:85px;
    background:#161620;
    border:5px solid #d4a93c;
    border-radius:50%;
    left:50%;
    top:50%;
    transform:translate(-50%,-50%);
    display:flex;
    justify-content:center;
    align-items:center;
    color:var(--gold);
    font-size:28px;
}

.wheel.spinWheel{
    animation:wheelSpin 2.5s cubic-bezier(.12,.8,.2,1);
}

@keyframes wheelSpin{
    from{transform:rotate(0deg)}
    to{transform:rotate(1080deg)}
}

.betOptions{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:10px;
    margin:15px 0;
}

.bet{
    background:#191924;
    padding:14px;
    border:1px solid var(--border);
    border-radius:12px;
}

.bet.selected{
    border-color:var(--gold);
    color:var(--gold);
}

/* DICE */

.diceBox{
    max-width:700px;
    margin:auto;
    text-align:center;
}

.dice{
    font-size:130px;
    height:180px;
    display:flex;
    justify-content:center;
    align-items:center;
    animation:none;
}

.dice.roll{
    animation:diceRoll .6s ease;
}

@keyframes diceRoll{
    0%{transform:rotate(0) scale(1)}
    50%{transform:rotate(360deg) scale(1.2)}
    100%{transform:rotate(720deg) scale(1)}
}

.diceChoices{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:10px;
    margin:15px 0;
}

.choice{
    padding:15px;
    border-radius:12px;
    background:#191924;
    border:1px solid var(--border);
}

.choice.selected{
    border-color:var(--gold);
    color:var(--gold);
}

/* BLACKJACK */

.blackjack{
    max-width:950px;
    margin:auto;
}

.table{
    min-height:400px;
    border-radius:30px;
    padding:25px;
    background:
      radial-gradient(circle,#164c36,#071e16 70%);
    border:8px solid #6a4d19;
    box-shadow:0 0 50px rgba(0,0,0,.4);
}

.handTitle{
    color:#aaa;
    margin-bottom:10px;
}

.cards{
    display:flex;
    gap:10px;
    min-height:120px;
    margin-bottom:25px;
}

.playCard{
    width:78px;
    height:110px;
    background:#f7f7f7;
    color:#111;
    border-radius:10px;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:28px;
    box-shadow:0 7px 15px rgba(0,0,0,.3);
    animation:cardIn .3s ease;
}

.playCard.redCard{
    color:#d72638;
}

@keyframes cardIn{
    from{opacity:0;transform:translateY(-20px) rotate(-5deg)}
    to{opacity:1;transform:none}
}

.gameButtons{
    display:flex;
    justify-content:center;
    gap:10px;
    flex-wrap:wrap;
}

/* PROFILE */

.profileHeader{
    display:flex;
    align-items:center;
    gap:20px;
}

.avatar{
    width:80px;
    height:80px;
    border-radius:50%;
    display:flex;
    justify-content:center;
    align-items:center;
    background:linear-gradient(135deg,#f5c451,#7e5413);
    font-size:35px;
    color:#17120a;
    font-weight:900;
}

.progress{
    height:10px;
    background:#242431;
    border-radius:20px;
    overflow:hidden;
    margin-top:10px;
}

.progress div{
    height:100%;
    width:55%;
    background:linear-gradient(90deg,#f5c451,#fff0ae);
}

/* HISTORY */

table{
    width:100%;
    border-collapse:collapse;
}

th,td{
    padding:14px;
    text-align:left;
    border-bottom:1px solid var(--border);
}

th{
    color:var(--muted);
}

/* CHART */

.chart{
    width:100%;
    height:260px;
    background:#0d0d15;
    border-radius:15px;
}

/* TOAST */

.toast{
    position:fixed;
    right:25px;
    bottom:25px;
    background:#191923;
    border:1px solid var(--gold);
    color:white;
    padding:15px 20px;
    border-radius:12px;
    transform:translateY(120px);
    opacity:0;
    transition:.3s;
    z-index:100;
}

.toast.show{
    transform:none;
    opacity:1;
}

/* MOBILE */

.mobileNav{
    display:none;
}

@media(max-width:900px){

    .sidebar{
        display:none;
    }

    .main{
        margin-left:0;
        width:100%;
        padding:15px;
        padding-bottom:90px;
    }

    .grid{
        grid-template-columns:repeat(2,1fr);
    }

    .rouletteWrap{
        grid-template-columns:1fr;
    }

    .wheel{
        width:270px;
        height:270px;
    }

    .mobileNav{
        position:fixed;
        display:flex;
        left:10px;
        right:10px;
        bottom:10px;
        height:65px;
        background:rgba(20,20,29,.96);
        backdrop-filter:blur(15px);
        border:1px solid var(--border);
        border-radius:18px;
        z-index:50;
        justify-content:space-around;
        align-items:center;
    }

    .mobileNav button{
        background:none;
        color:#8d8da2;
        font-size:11px;
    }

    .mobileNav button.active{
        color:var(--gold);
    }

    .topbar{
        align-items:flex-start;
    }

    .topBalance{
        font-size:13px;
    }

    .hero h2{
        font-size:25px;
    }

    .hero .chips{
        font-size:60px;
    }
}

@media(max-width:550px){

    .grid{
        grid-template-columns:1fr 1fr;
        gap:10px;
    }

    .card{
        padding:15px;
    }

    .stat h2{
        font-size:20px;
    }

    .reel{
        height:110px;
        font-size:55px;
    }

    .slotScreen{
        padding:15px;
    }

    .slotControls{
        flex-direction:column;
    }

    .primary{
        width:100%;
    }

    .playCard{
        width:58px;
        height:85px;
        font-size:22px;
    }

    .cards{
        gap:5px;
    }

    th,td{
        padding:9px 5px;
        font-size:12px;
    }
}
</style>
</head>

<body>

<div class="app">

<!-- SIDEBAR -->

<aside class="sidebar">

    <div class="logo">♛ <span>ROYAL</span> CASINO</div>

    <div class="nav">

        <button class="active" onclick="showPage('home',this)">
            🏠 Dashboard
        </button>

        <button onclick="showPage('slots',this)">
            🎰 Slots
        </button>

        <button onclick="showPage('roulette',this)">
            🎡 Roulette
        </button>

        <button onclick="showPage('blackjack',this)">
            🃏 Blackjack
        </button>

        <button onclick="showPage('dice',this)">
            🎲 Dice
        </button>

        <button onclick="showPage('stats',this)">
            📊 Statistics
        </button>

        <button onclick="showPage('history',this)">
            📜 History
        </button>

        <button onclick="showPage('profile',this)">
            👤 Profile
        </button>

    </div>

    <div class="balanceBox">
        <small>Virtual Balance</small>
        <div class="balance" id="sideBalance">10,000 🪙</div>
    </div>

</aside>


<main class="main">

<!-- TOPBAR -->

<div class="topbar">

    <div class="welcome">
        <h1>Royal Casino 🎰</h1>
        <p>Virtual casino simulator</p>
    </div>

    <div class="topBalance">
        🪙 <span id="topBalance">10,000</span>
    </div>

</div>


<!-- HOME -->

<section id="home" class="page active">

    <div class="grid">

        <div class="card stat">
            <small>Balance</small>
            <h2 class="gold" id="statBalance">10,000 🪙</h2>
        </div>

        <div class="card stat">
            <small>Total Games</small>
            <h2 id="statGames">0</h2>
        </div>

        <div class="card stat">
            <small>Total Wins</small>
            <h2 class="green" id="statWins">0</h2>
        </div>

        <div class="card stat">
            <small>XP Level</small>
            <h2 class="gold" id="statLevel">Level 1</h2>
        </div>

    </div>


    <div class="hero">

        <h2>WELCOME TO ROYAL 👑</h2>

        <p>
            ითამაშე სხვადასხვა თამაშის დემო-ვერსია,
            დააგროვე ვირტუალური მონეტები და აიმაღლე დონე.
            აქ რეალური ფული არ გამოიყენება.
        </p>

        <div class="chips">🎰</div>

    </div>


    <div class="card" style="margin-top:20px">

        <h2>🔥 Games</h2>

        <div class="grid" style="margin-top:15px">

            <div class="card" onclick="showPage('slots')" style="cursor:pointer">
                <div style="font-size:45px">🎰</div>
                <h3>Lucky Slots</h3>
                <p style="color:#888;margin-top:5px">Spin the reels</p>
            </div>

            <div class="card" onclick="showPage('roulette')" style="cursor:pointer">
                <div style="font-size:45px">🎡</div>
                <h3>Roulette</h3>
                <p style="color:#888;margin-top:5px">Red or black</p>
            </div>

            <div class="card" onclick="showPage('blackjack')" style="cursor:pointer">
                <div style="font-size:45px">🃏</div>
                <h3>Blackjack</h3>
                <p style="color:#888;margin-top:5px">Beat the dealer</p>
            </div>

            <div class="card" onclick="showPage('dice')" style="cursor:pointer">
                <div style="font-size:45px">🎲</div>
                <h3>Dice</h3>
                <p style="color:#888;margin-top:5px">Roll the dice</p>
            </div>

        </div>

    </div>

</section>


<!-- SLOTS -->

<section id="slots" class="page">

    <div class="gameHeader">
        <h2>🎰 Lucky Slots</h2>
        <button class="backBtn" onclick="showPage('home')">← Back</button>
    </div>

    <div class="slotMachine">

        <div class="slotScreen">

            <div class="reels">

                <div class="reel" id="r1">🍒</div>
                <div class="reel" id="r2">⭐</div>
                <div class="reel" id="r3">💎</div>

            </div>

            <div class="result" id="slotResult">
                Ready to spin
            </div>

            <div class="slotControls">

                <input
                    id="slotAmount"
                    class="amountInput"
                    type="number"
                    min="1"
                    value="100"
                    placeholder="Virtual coins"
                >

                <button class="primary" onclick="spinSlots()">
                    SPIN 🎰
                </button>

            </div>

        </div>

        <div class="card" style="margin-top:15px">

            <h3>🎯 Slot Rewards</h3>

            <p style="color:#999;margin-top:10px">
                💎 💎 💎 = x10
            </p>

            <p style="color:#999;margin-top:5px">
                ⭐ ⭐ ⭐ = x5
            </p>

            <p style="color:#999;margin-top:5px">
                🍒 🍒 🍒 = x3
            </p>

            <p style="color:#999;margin-top:5px">
                ნებისმიერი ორი ერთნაირი = x2
            </p>

        </div>

    </div>

</section>


<!-- ROULETTE -->

<section id="roulette" class="page">

    <div class="gameHeader">

        <h2>🎡 Roulette</h2>

        <button class="backBtn" onclick="showPage('home')">
            ← Back
        </button>

    </div>

    <div class="rouletteWrap">

        <div class="card">

            <div class="wheel" id="wheel"></div>

        </div>

        <div class="card">

            <h3>Choose Color</h3>

            <div class="betOptions">

                <button class="bet selected" id="redBet"
                        onclick="selectRoulette('red')">
                    🔴 RED
                </button>

                <button class="bet" id="blackBet"
                        onclick="selectRoulette('black')">
                    ⚫ BLACK
                </button>

            </div>

            <input
                id="rouletteAmount"
                class="amountInput"
                type="number"
                value="100"
                min="1"
                style="width:100%"
            >

            <button
                class="primary"
                style="width:100%;margin-top:10px"
                onclick="spinRoulette()"
            >
                SPIN WHEEL 🎡
            </button>

            <div class="result" id="rouletteResult">
                Choose your color
            </div>

        </div>

    </div>

</section>


<!-- BLACKJACK -->

<section id="blackjack" class="page">

    <div class="gameHeader">

        <h2>🃏 Blackjack</h2>

        <button class="backBtn" onclick="showPage('home')">
            ← Back
        </button>

    </div>

    <div class="blackjack">

        <div class="table">

            <div class="handTitle">
                Dealer — <span id="dealerScore">0</span>
            </div>

            <div class="cards" id="dealerCards"></div>


            <div class="handTitle">
                You — <span id="playerScore">0</span>
            </div>

            <div class="cards" id="playerCards"></div>


            <div class="gameButtons">

                <button class="primary"
                        onclick="startBlackjack()">
                    New Game
                </button>

                <button class="bet"
                        onclick="hit()">
                    Hit
                </button>

                <button class="bet"
                        onclick="stand()">
                    Stand
                </button>

            </div>

            <div class="result" id="blackjackResult">
                Start a new game
            </div>

        </div>

    </div>

</section>


<!-- DICE -->

<section id="dice" class="page">

    <div class="gameHeader">

        <h2>🎲 Lucky Dice</h2>

        <button class="backBtn" onclick="showPage('home')">
            ← Back
        </button>

    </div>

    <div class="diceBox card">

        <div class="dice" id="dice">🎲</div>

        <h3>Choose High or Low</h3>

        <div class="diceChoices">

            <button
                class="choice selected"
                id="lowChoice"
                onclick="selectDice('low')">
                LOW 1–3
            </button>

            <button
                class="choice"
                id="highChoice"
                onclick="selectDice('high')">
                HIGH 4–6
            </button>

        </div>

        <input
            id="diceAmount"
            class="amountInput"
            type="number"
            value="100"
            min="1"
            style="width:100%"
        >

        <button
            class="primary"
            style="width:100%;margin-top:10px"
