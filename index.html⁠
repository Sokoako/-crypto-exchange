<!DOCTYPE html>
<html lang="ka">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Binance - Live Crypto Trading Platform</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            background-color: #0b0e14;
            color: #eaecef;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0b0e14;
        }
        ::-webkit-scrollbar-thumb {
            background: #1e2329;
            border-radius: 3px;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

    <!-- Top Navigation -->
    <header class="border-b border-[#1e2329] bg-[#12161c]/90 backdrop-blur-md sticky top-0 z-50 px-4 lg:px-8 py-3.5 flex justify-between items-center">
        <div class="flex items-center gap-6">
            <div class="flex items-center gap-2.5">
                <div class="bg-[#FCD535] p-2 rounded-lg text-slate-950 font-black text-lg shadow-lg shadow-[#FCD535]/20">BN</div>
                <span class="font-bold text-xl tracking-wider text-white">BINANCE<span class="text-[#FCD535]"> PRO</span></span>
            </div>
            <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-400">
                <a href="#" class="text-white hover:text-[#FCD535] transition-colors">ბირჟა (Markets)</a>
                <a href="#" class="hover:text-[#FCD535] transition-colors">ვაჭრობა (Trade)</a>
                <a href="#" class="hover:text-[#FCD535] transition-colors">საფულე (Wallet)</a>
            </nav>
        </div>
        <div class="flex items-center gap-3">
            <div class="bg-[#1e2329] px-3.5 py-1.5 rounded-full text-xs font-semibold text-[#FCD535] border border-[#FCD535]/20 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[#FCD535] animate-pulse"></span>
                ONLINE
            </div>
        </div>
    </header>

    <!-- Main Content Grid -->
    <main class="max-w-7xl w-full mx-auto p-4 lg:p-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Left Column: Markets & Prices -->
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-[#12161c] border border-[#1e2329] rounded-2xl p-5 shadow-xl">
                <h2 class="text-base font-bold text-white mb-4 flex items-center justify-between">
                    <span>მარკეტები (Markets)</span>
                    <span class="text-xs text-slate-400 font-normal">Real-time Data</span>
                </h2>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead>
                            <tr class="border-b border-[#1e2329] text-slate-400 text-xs">
                                <th class="pb-3 font-semibold">აქტივი</th>
                                <th class="pb-3 font-semibold">ფასი</th>
                                <th class="pb-3 font-semibold">24სთ ცვლილება</th>
                                <th class="pb-3 font-semibold text-right">მოქმედება</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[#1e2329]/50">
                            <tr class="hover:bg-[#1e2329]/30 transition-colors">
                                <td class="py-3.5 font-bold text-white flex items-center gap-2">🪙 BTC / USDT</td>
                                <td class="py-3.5 font-semibold text-white">$68,420.50</td>
                                <td class="py-3.5 font-semibold text-emerald-400">+3.45%</td>
                                <td class="py-3.5 text-right"><button onclick="quickSelect('BTC', 68420)" class="text-xs bg-[#FCD535]/10 text-[#FCD535] border border-[#FCD535]/30 px-3 py-1 rounded-lg hover:bg-[#FCD535] hover:text-slate-950 font-semibold transition-all">ვაჭრობა</button></td>
                            </tr>
                            <tr class="hover:bg-[#1e2329]/30 transition-colors">
                                <td class="py-3.5 font-bold text-white flex items-center gap-2">Ξ ETH / USDT</td>
                                <td class="py-3.5 font-semibold text-white">$3,540.10</td>
                                <td class="py-3.5 font-semibold text-emerald-400">+1.82%</td>
                                <td class="py-3.5 text-right"><button onclick="quickSelect('ETH', 3540)" class="text-xs bg-[#FCD535]/10 text-[#FCD535] border border-[#FCD535]/30 px-3 py-1 rounded-lg hover:bg-[#FCD535] hover:text-slate-950 font-semibold transition-all">ვაჭრობა</button></td>
                            </tr>
                            <tr class="hover:bg-[#1e2329]/30 transition-colors">
                                <td class="py-3.5 font-bold text-white flex items-center gap-2">🟣 SOL / USDT</td>
                                <td class="py-3.5 font-semibold text-white">$148.80</td>
                                <td class="py-3.5 font-semibold text-rose-400">-0.95%</td>
                                <td class="py-3.5 text-right"><button onclick="quickSelect('SOL', 148)" class="text-xs bg-[#FCD535]/10 text-[#FCD535] border border-[#FCD535]/30 px-3 py-1 rounded-lg hover:bg-[#FCD535] hover:text-slate-950 font-semibold transition-all">ვაჭრობა</button></td>
                            </tr>
                            <tr class="hover:bg-[#1e2329]/30 transition-colors">
                                <td class="py-3.5 font-bold text-white flex items-center gap-2">💵 USDT / USD</td>
                                <td class="py-3.5 font-semibold text-white">$1.00</td>
                                <td class="py-3.5 font-semibold text-slate-400">0.00%</td>
                                <td class="py-3.5 text-right"><button onclick="quickSelect('USDT', 1)" class="text-xs bg-[#FCD535]/10 text-[#FCD535] border border-[#FCD535]/30 px-3 py-1 rounded-lg hover:bg-[#FCD535] hover:text-slate-950 font-semibold transition-all">ვაჭრობა</button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Transaction History Section -->
            <div class="bg-[#12161c] border border-[#1e2329] rounded-2xl p-5 shadow-xl">
                <h3 class="text-base font-bold text-white mb-4">ტრანზაქციების ისტორია</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead>
                            <tr class="border-b border-[#1e2329] text-slate-400 text-xs">
                                <th class="pb-3 font-semibold">ოპერაცია</th>
                                <th class="pb-3 font-semibold">ოდენობა</th>
                                <th class="pb-3 font-semibold">თარიღი</th>
                                <th class="pb-3 font-semibold">სტატუსი</th>
                            </tr>
                        </thead>
                        <tbody id="historyTableBody" class="divide-y divide-[#1e2329]/50">
                            <tr>
                                <td class="py-3 font-medium text-emerald-400">Deposit (USDT)</td>
                                <td class="py-3 font-bold text-white">+1,250.00 USDT</td>
                                <td class="py-3 text-slate-400 text-xs">2026-06-08 12:45</td>
                                <td class="py-3"><span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs px-2.5 py-0.5 rounded-full">Completed</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Column: Wallet Balance & Deposit/Withdraw Panel -->
        <div class="space-y-6">
            <!-- Total Balance Card -->
            <div class="bg-gradient-to-br from-[#12161c] to-[#181d26] border border-[#1e2329] rounded-2xl p-6 shadow-xl relative overflow-hidden">
                <div class="absolute -right-6 -bottom-6 w-32 h-32 bg-[#FCD535]/5 rounded-full blur-2xl"></div>
                <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">ჯამური ბალანსი (Total Balance)</p>
                <h2 id="totalBalanceDisplay" class="text-3xl font-black text-white tracking-tight mb-4">$12,450.00</h2>
                <div class="grid grid-cols-2 gap-3 pt-3 border-t border-[#1e2329]">
                    <div>
                        <span class="text-[11px] text-slate-400 block">ხელმისაწვდომი</span>
                        <span class="text-sm font-bold text-[#FCD535]">$10,200.00</span>
                    </div>
                    <div>
                        <span class="text-[11px] text-slate-400 block">ორდერებში</span>
                        <span class="text-sm font-bold text-slate-300">$2,250.00</span>
                    </div>
                </div>
            </div>

            <!-- Deposit / Withdraw Action Box -->
            <div class="bg-[#12161c] border border-[#1e2329] rounded-2xl p-5 shadow-xl">
                <div class="flex bg-[#0b0e14] p-1 rounded-xl border border-[#1e2329] mb-5">
                    <button onclick="setTab('deposit')" id="depBtn" class="flex-1 py-2 text-xs font-bold rounded-lg bg-[#FCD535] text-slate-950 transition-all shadow-md">შეტანა (Deposit)</button>
                    <button onclick="setTab('withdraw')" id="witBtn" class="flex-1 py-2 text-xs font-bold rounded-lg text-slate-400 hover:text-white transition-all">გატანა (Withdraw)</button>
                </div>

                <form onsubmit="executeAction(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1.5">ვალუტა</label>
                        <select id="assetSelect" class="w-full bg-[#0b0e14] border border-[#1e2329] rounded-xl px-3 py-2.5 text-sm text-white font-medium focus:outline-none focus:border-[#FCD535]">
                            <option value="USDT">USDT (Tether)</option>
                            <option value="BTC">BTC (Bitcoin)</option>
                            <option value="ETH">Ethereum (ETH)</option>
                            <option value="SOL">Solana (SOL)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1.5">თანხის ოდენობა</label>
                        <div class="relative">
                            <input type="number" step="any" id="sumInput" placeholder="0.00" class="w-full bg-[#0b0e14] border border-[#1e2329] rounded-xl px-3 py-2.5 text-sm text-white font-bold focus:outline-none focus:border-[#FCD535]" required>
                            <span id="inputBadge" class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-400 font-bold">USDT</span>
                        </div>
                    </div>
                    <button type="submit" id="actionSubmitBtn" class="w-full py-3 rounded-xl bg-[#FCD535] hover:bg-[#f0c929] text-slate-950 font-bold text-sm shadow-lg shadow-[#FCD535]/20 transition-all">
                        თანხის შეტანა
                    </button>
                </form>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-[#1e2329] bg-[#12161c] py-4 text-center text-xs text-slate-500">
        &copy; 2026 Binance Proxy Exchange. ყველა უფლება დაცულია.
    </footer>

    <!-- JavaScript Engine -->
    <script>
        let balance = 12450.00;
        let currentMode = 'deposit';

        const assetSelect = document.getElementById('assetSelect');
        const inputBadge = document.getElementById('inputBadge');

        assetSelect.addEventListener('change', (e) => {
            inputBadge.innerText = e.target.value;
        });

        function setTab(mode) {
            currentMode = mode;
            const depBtn = document.getElementById('depBtn');
            const witBtn = document.getElementById('witBtn');
            const subBtn = document.getElementById('actionSubmitBtn');

            if (mode === 'deposit') {
                depBtn.className = "flex-1 py-2 text-xs font-bold rounded-lg bg-[#FCD535] text-slate-950 transition-all shadow-md";
                witBtn.className = "flex-1 py-2 text-xs font-bold rounded-lg text-slate-400 hover:text-white transition-all";
                subBtn.innerText = "თანხის შეტანა";
                subBtn.className = "w-full py-3 rounded-xl bg-[#FCD535] hover:bg-[#f0c929] text-slate-950 font-bold text-sm shadow-lg shadow-[#FCD535]/20 transition-all";
            } else {
                witBtn.className = "flex-1 py-2 text-xs font-bold rounded-lg bg-rose-500 text-slate-950 transition-all shadow-md";
                depBtn.className = "flex-1 py-2 text-xs font-bold rounded-lg text-slate-400 hover:text-white transition-all";
                subBtn.innerText = "გატანის მოთხოვნა";
                subBtn.className = "w-full py-3 rounded-xl bg-rose-500 hover:bg-rose-400 text-slate-950 font-bold text-sm shadow-lg shadow-rose-500/20 transition-all";
            }
        }

        function quickSelect(asset) {
            assetSelect.value = asset;
            inputBadge.innerText = asset;
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function executeAction(e) {
            e.preventDefault();
            const sumInput = document.getElementById('sumInput');
            const val = parseFloat(sumInput.value);
            const asset = assetSelect.value;

            if (!val || val <= 0) return;

            if (currentMode === 'deposit') {
                balance += val;
                appendHistory(asset, `+${val} ${asset}`, 'Deposit', 'Completed', 'text-emerald-400');
            } else {
                if (val > balance) {
                    alert('არასაკმარისი ბალანსი!');
                    return;
                }
                balance -= val;
                appendHistory(asset, `-${val} ${asset}`, 'Withdraw', 'Pending', 'text-rose-400');
            }

            document.getElementById('totalBalanceDisplay').innerText = '$' + balance.toLocaleString('en-US', { minimumFractionDigits: 2 });
            sumInput.value = '';
        }

        function appendHistory(asset, amountStr, type, status, colorClass) {
            const tbody = document.getElementById('historyTableBody');
            const now = new Date().toISOString().slice(0, 19).replace('T', ' ');
            const statusBadge = status === 'Completed' 
                ? '<span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs px-2.5 py-0.5 rounded-full">Completed</span>'
                : '<span class="bg-amber-500/10 text-amber-400 border border-amber-500/20 text-xs px-2.5 py-0.5 rounded-full">Pending</span>';

            const row = document.createElement('tr');
            row.innerHTML = `
                <td class="py-3 font-medium ${colorClass}">${type} (${asset})</td>
                <td class="py-3 font-bold text-white">${amountStr}</td>
                <td class="py-3 text-slate-400 text-xs">${now}</td>
                <td class="py-3">${statusBadge}</td>
            `;
            tbody.prepend(row);
        }
    </script>
</body>
</html>
<!DOCTYPE html>
<html lang="ka">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MetaMask Integration</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-[#0b0e14] text-[#eaecef] p-6 flex flex-col items-center justify-center font-sans">
    
    <div class="max-w-md w-full bg-[#12161c] border border-[#1e2329] rounded-2xl p-6 shadow-2xl">
        <div class="flex items-center justify-between mb-6">
            <h1 class="text-xl font-bold text-white tracking-wide">WEB3 საფულე</h1>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
        </div>

        <div id="errorBox" class="hidden mb-4 p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs font-medium"></div>

        <div id="connectSection">
            <button onclick="connectWallet()" id="connectBtn" class="w-full py-3.5 rounded-xl bg-[#FCD535] hover:bg-[#f0c929] text-slate-950 font-bold text-sm shadow-lg shadow-[#FCD535]/20 transition-all flex items-center justify-center gap-2">
                🔗 MetaMask-ის მიერთება
            </button>
        </div>

        <div id="walletSection" class="hidden space-y-4">
            <div class="bg-[#0b0e14] p-3.5 rounded-xl border border-[#1e2329]">
                <span class="text-[11px] text-slate-400 block mb-1">დაკავშირებული ანგარიში</span>
                <p id="accountText" class="text-xs font-mono font-bold text-amber-400 break-all"></p>
            </div>

            <div class="bg-[#0b0e14] p-3.5 rounded-xl border border-[#1e2329] flex justify-between items-center">
                <span class="text-xs text-slate-400">ETH ბალანსი:</span>
                <span id="balanceText" class="text-sm font-bold text-white">იტვირთება...</span>
            </div>

            <button onclick="disconnectWallet()" class="w-full py-2.5 rounded-xl bg-[#1e2329] hover:bg-rose-500/10 hover:text-rose-400 text-slate-400 font-semibold text-xs transition-all border border-[#1e2329]">
                გასვლა (Disconnect)
            </button>
        </div>
    </div>

    <script>
        async function connectWallet() {
            const errorBox = document.getElementById('errorBox');
            errorBox.classList.add('hidden');

            if (typeof window.ethereum === 'undefined') {
                errorBox.innerText = 'MetaMask არ არის დაინსტალირებული ბრაუზერში!';
                errorBox.classList.remove('hidden');
                return;
            }

            try {
                const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });
                const userAccount = accounts[0];

                document.getElementById('accountText').innerText = userAccount;
                document.getElementById('connectSection').classList.add('hidden');
                document.getElementById('walletSection').classList.remove('hidden');

                // ბალანსის წამოღება
                const rawBalance = await window.ethereum.request({
                    method: 'eth_getBalance',
                    params: [userAccount, 'latest'],
                });

                const ethBalance = parseInt(rawBalance, 16) / Math.pow(10, 18);
                document.getElementById('balanceText').innerText = ethBalance.toFixed(4) + ' ETH';
            } catch (err) {
                errorBox.innerText = 'კავშირი გაუქმდა ან შეცდომა მოხდა.';
                errorBox.classList.remove('hidden');
            }
        }

        function disconnectWallet() {
            document.getElementById('walletSection').classList.add('hidden');
            document.getElementById('connectSection').classList.remove('hidden');
            document.getElementById('balanceText').innerText = 'იტვირთება...';
        }
    </script>
</body>
</html>
