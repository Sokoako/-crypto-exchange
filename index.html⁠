<!DOCTYPE html>
<html lang="ka">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>CryptoX Simulator</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,Helvetica,sans-serif;
}

:root{
    --bg:#080b12;
    --panel:#10151f;
    --panel2:#151c28;
    --border:#232d3d;
    --text:#ffffff;
    --muted:#8490a3;
    --blue:#20b8ff;
    --green:#20d98b;
    --red:#ff5267;
}

body{
    background:var(--bg);
    color:var(--text);
    min-height:100vh;
}

/* ================= HEADER ================= */

header{
    height:70px;
    background:#0c111a;
    border-bottom:1px solid var(--border);

    display:flex;
    align-items:center;
    justify-content:space-between;

    padding:0 25px;

    position:sticky;
    top:0;
    z-index:100;
}

.logo{
    font-size:25px;
    font-weight:800;
    color:var(--blue);
}

.logo span{
    color:white;
}

.header-right{
    display:flex;
    align-items:center;
    gap:12px;
}

.balance-mini{
    background:var(--panel2);
    border:1px solid var(--border);
    padding:9px 14px;
    border-radius:9px;
    font-weight:bold;
}

.profile-btn{
    width:40px;
    height:40px;
    border-radius:50%;
    border:0;
    background:var(--blue);
    cursor:pointer;
    font-weight:bold;
}

/* ================= LAYOUT ================= */

.app{
    display:flex;
    min-height:calc(100vh - 70px);
}

/* SIDEBAR */

.sidebar{
    width:230px;
    background:#0c111a;
    border-right:1px solid var(--border);
    padding:20px 12px;
    flex-shrink:0;
}

.nav-btn{
    width:100%;
    padding:13px 15px;
    margin-bottom:7px;

    border:0;
    background:transparent;
    color:#9aa5b7;

    text-align:left;
    border-radius:9px;

    cursor:pointer;
    font-size:14px;
}

.nav-btn:hover,
.nav-btn.active{
    background:#172333;
    color:white;
}

.nav-icon{
    width:25px;
    display:inline-block;
}

/* CONTENT */

.content{
    flex:1;
    max-width:1400px;
    margin:auto;
    padding:25px;
}

.page{
    display:none;
}

.page.active{
    display:block;
}

/* ================= DASHBOARD ================= */

.welcome{
    margin-bottom:25px;
}

.welcome h1{
    font-size:32px;
    margin-bottom:7px;
}

.muted{
    color:var(--muted);
}

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.card{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:13px;
    padding:20px;
}

.stat-title{
    color:var(--muted);
    font-size:13px;
}

.stat-value{
    font-size:26px;
    font-weight:bold;
    margin-top:9px;
}

.green{
    color:var(--green);
}

.red{
    color:var(--red);
}

.blue{
    color:var(--blue);
}

/* ================= MARKET ================= */

.section-title{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:15px;
}

.search{
    background:var(--panel);
    border:1px solid var(--border);
    color:white;
    padding:12px 15px;
    border-radius:9px;
    outline:none;
    width:260px;
}

.market-table{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:13px;
    overflow:hidden;
}

.market-row{
    display:grid;
    grid-template-columns:2fr 1.3fr 1fr 1fr;
    align-items:center;

    padding:17px 20px;

    border-bottom:1px solid var(--border);
}

.market-row:last-child{
    border-bottom:0;
}

.market-header{
    color:var(--muted);
    font-size:12px;
}

.coin-info{
    display:flex;
    align-items:center;
    gap:12px;
}

.coin-icon{
    width:40px;
    height:40px;
    border-radius:50%;
    background:#1b2535;

    display:flex;
    align-items:center;
    justify-content:center;

    font-weight:bold;
}

.coin-name{
    font-weight:bold;
}

.coin-symbol{
    color:var(--muted);
    font-size:12px;
    margin-top:3px;
}

.trade-small{
    border:0;
    background:var(--blue);
    color:#001018;
    padding:8px 13px;
    border-radius:7px;
    font-weight:bold;
    cursor:pointer;
}

/* ================= TRADE ================= */

.trade-layout{
    display:grid;
    grid-template-columns:1.5fr 1fr;
    gap:20px;
}

.chart-card{
    min-height:500px;
}

.chart-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.big-price{
    font-size:34px;
    font-weight:bold;
    margin-top:10px;
}

canvas{
    width:100%;
    height:330px;
    margin-top:25px;
}

.trade-box{
    display:flex;
    flex-direction:column;
    gap:13px;
}

.trade-box label{
    color:var(--muted);
    font-size:13px;
}

.trade-box select,
.trade-box input{
    background:#080b12;
    border:1px solid var(--border);
    color:white;
    padding:14px;
    border-radius:8px;
    outline:none;
}

.buy-sell{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
    margin-top:10px;
}

.buy{
    background:var(--green);
    color:#00170d;
}

.sell{
    background:var(--red);
    color:white;
}

.buy,
.sell{
    border:0;
    padding:14px;
    border-radius:8px;
    font-weight:bold;
    cursor:pointer;
}

/* ================= WALLET ================= */

.wallet-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}

.wallet-balance{
    font-size:36px;
    font-weight:bold;
    margin-top:8px;
}

.asset{
    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:15px 0;

    border-bottom:1px solid var(--border);
}

.asset:last-child{
    border-bottom:0;
}

.asset-left{
    display:flex;
    align-items:center;
    gap:10px;
}

/* ================= HISTORY ================= */

.history{
    margin-top:20px;
}

.history-row{
    display:grid;
    grid-template-columns:1fr 1fr 1fr;
    padding:14px 0;
    border-bottom:1px solid var(--border);
}

/* ================= PROFILE ================= */

.profile-card{
    max-width:600px;
}

.avatar-big{
    width:90px;
    height:90px;
    border-radius:50%;

    background:var(--blue);

    display:flex;
    align-items:center;
    justify-content:center;

    font-size:35px;
    color:#001018;

    margin-bottom:20px;
}

.profile-input{
    width:100%;
    padding:13px;
    margin-top:8px;
    margin-bottom:15px;

    background:#080b12;
    color:white;

    border:1px solid var(--border);
    border-radius:8px;
}

.primary{
    background:var(--blue);
    color:#001018;

    border:0;
    padding:12px 18px;

    border-radius:8px;
    cursor:pointer;
    font-weight:bold;
}

/* ================= MODAL ================= */

.modal{
    display:none;

    position:fixed;
    inset:0;

    background:rgba(0,0,0,.75);

    align-items:center;
    justify-content:center;

    z-index:500;
}

.modal-box{
    width:90%;
    max-width:420px;

    background:var(--panel);

    border:1px solid var(--border);

    border-radius:13px;

    padding:25px;
}

.modal-box h2{
    margin-bottom:20px;
}

.modal-box input{
    width:100%;
    padding:13px;

    margin-bottom:12px;

    background:#080b12;
    border:1px solid var(--border);

    color:white;

    border-radius:8px;
}

.modal-close{
    float:right;
    cursor:pointer;
    font-size:22px;
    color:var(--muted);
}

/* ================= NOTIFICATION ================= */

.toast{
    position:fixed;

    right:20px;
    bottom:20px;

    background:#182333;

    border:1px solid var(--border);

    padding:14px 18px;

    border-radius:9px;

    display:none;

    z-index:1000;
}

/* ================= MOBILE NAV ================= */

.mobile-nav{
    display:none;
}

/* ================= RESPONSIVE ================= */

@media(max-width:1000px){

    .sidebar{
        width:190px;
    }

    .stats{
        grid-template-columns:repeat(2,1fr);
    }

    .trade-layout{
        grid-template-columns:1fr;
    }

}

@media(max-width:700px){

    header{
        padding:0 13px;
    }

    .balance-mini{
        display:none;
    }

    .sidebar{
        display:none;
    }

    .content{
        padding:15px;
        padding-bottom:85px;
    }

    .welcome h1{
        font-size:25px;
    }

    .stats{
        grid-template-columns:1fr 1fr;
        gap:10px;
    }

    .stat-value{
        font-size:20px;
    }

    .section-title{
        align-items:flex-start;
        flex-direction:column;
        gap:10px;
    }

    .search{
        width:100%;
    }

    .market-header{
        display:none;
    }

    .market-row{
        grid-template-columns:1fr auto;
        gap:10px;
        padding:15px;
    }

    .market-row > div:nth-child(2),
    .market-row > div:nth-child(3){
        display:none;
    }

    .wallet-grid{
        grid-template-columns:1fr;
    }

    .chart-card{
        min-height:400px;
    }

    canvas{
        height:260px;
    }

    .mobile-nav{
        position:fixed;
        display:grid;

        grid-template-columns:repeat(5,1fr);

        left:0;
        right:0;
        bottom:0;

        height:65px;

        background:#0c111a;
        border-top:1px solid var(--border);

        z-index:300;
    }

    .mobile-nav button{
        border:0;
        background:transparent;
        color:#7e8a9c;
        font-size:11px;
    }

    .mobile-nav button.active{
        color:var(--blue);
    }

}

</style>
</head>


