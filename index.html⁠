<!DOCTYPE html>
<html lang="ka">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>CryptoX — Crypto Dashboard</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#080b12;
    color:#fff;
}

header{
    height:70px;
    background:#0d111a;
    border-bottom:1px solid #202632;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 25px;
    position:sticky;
    top:0;
    z-index:100;
}

.logo{
    font-size:24px;
    font-weight:bold;
    color:#00e5ff;
}

nav{
    display:flex;
    gap:20px;
}

nav a{
    color:#aaa;
    text-decoration:none;
}

nav a:hover{
    color:#00e5ff;
}

.header-buttons{
    display:flex;
    gap:10px;
}

button{
    border:0;
    cursor:pointer;
    border-radius:8px;
    padding:11px 18px;
    font-weight:bold;
}

.login{
    background:#1a202c;
    color:white;
}

.register{
    background:#00d4ff;
    color:#001018;
}

.container{
    max-width:1250px;
    margin:auto;
    padding:25px;
}

.hero{
    padding:40px 0;
}

.hero h1{
    font-size:42px;
    margin-bottom:12px;
}

.hero p{
    color:#8c96a8;
    font-size:17px;
}

.live{
    display:inline-flex;
    align-items:center;
    gap:7px;
    color:#4cff91;
    margin-top:20px;
}

.dot{
    width:9px;
    height:9px;
    border-radius:50%;
    background:#4cff91;
}

.market{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.card{
    background:#10151f;
    border:1px solid #202938;
    border-radius:14px;
    padding:20px;
}

.coin-top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:18px;
}

.coin{
    display:flex;
    align-items:center;
    gap:10px;
}

.coin-icon{
    width:38px;
    height:38px;
    border-radius:50%;
    background:#1b2433;
    display:flex;
    justify-content:center;
    align-items:center;
    font-weight:bold;
}

.price{
    font-size:24px;
    font-weight:bold;
}

.green{
    color:#35e98b;
}

.red{
    color:#ff5364;
}

.search{
    margin:30px 0 15px;
}

.search input{
    width:100%;
    background:#10151f;
    border:1px solid #273244;
    padding:15px;
    color:white;
    border-radius:9px;
    outline:none;
}

.exchange{
    display:grid;
    grid-template-columns:1.3fr 1fr;
    gap:20px;
    margin-top:30px;
}

.chart{
    min-height:420px;
}

canvas{
    width:100%;
    height:320px;
}

.trade{
    display:flex;
    flex-direction:column;
    gap:15px;
}

.trade select,
.trade input{
    background:#080b12;
    border:1px solid #293346;
    color:white;
    padding:14px;
    border-radius:8px;
}

.trade-buttons{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
}

.buy{
    background:#20d985;
    color:#00150b;
}

.sell{
    background:#ff4e62;
    color:white;
}

.portfolio{
    margin-top:30px;
}

.balance{
    font-size:32px;
    margin-top:8px;
}

.assets{
    margin-top:20px;
}

.asset{
    display:flex;
    justify-content:space-between;
    padding:16px 0;
    border-bottom:1px solid #202632;
}

.modal{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.75);
    display:none;
    justify-content:center;
    align-items:center;
    z-index:500;
}

.modal-box{
    width:90%;
    max-width:420px;
    background:#10151f;
    border:1px solid #293346;
    padding:25px;
    border-radius:15px;
}

.modal-box h2{
    margin-bottom:20px;
}

.modal-box input{
    width:100%;
    padding:14px;
    margin-bottom:12px;
    background:#080b12;
    color:white;
    border:1px solid #293346;
    border-radius:8px;
}

.modal-box button{
    width:100%;
    background:#00d4ff;
}

.close{
    float:right;
    cursor:pointer;
    color:#aaa;
    font-size:22px;
}

footer{
    text-align:center;
    color:#697386;
    padding:40px 20px;
    margin-top:50px;
    border-top:1px solid #202632;
}

@media(max-width:850px){

    nav{
        display:none;
    }

    .market{
        grid-template-columns:repeat(2,1fr);
    }

    .exchange{
        grid-template-columns:1fr;
    }

    .hero h1{
        font-size:32px;
    }
}

@media(max-width:500px){

    header{
        padding:0 12px;
    }

    .logo{
        font-size:19px;
    }

    .header-buttons button{
        padding:9px;
        font-size:12px;
    }

    .container{
        padding:15px;
    }

    .market{
        grid-template-columns:1fr;
    }

    .price{
        font-size:20px;
    }
}
</style>
</head>

<body>

<header>

    <div class="logo">₿ CryptoX</div>

    <nav>
        <a href="#markets">Markets</a>
        <a href="#exchange">Trade</a>
        <a href="#portfolio">Portfolio</a>
    </nav>

    <div class="header-buttons">
        <button class="login" onclick="openModal('login')">
            Login
        </button>

        <button class="register" onclick="openModal('register')">
            Register
        </button>
    </div>

</header>


<main class="container">

<section class="hero">

    <h1>Crypto Market</h1>

    <p>
        Track cryptocurrency prices and manage your demo portfolio.
    </p>

    <div class="live">
        <span class="dot"></span>
        LIVE MARKET DATA
    </div>

</section>


<section id="markets">

    <h2>Markets</h2>

    <div class="search">
        <input
            type="text"
            id="search"
            placeholder="Search cryptocurrency..."
            oninput="filterCoins()"
        >
    </div>

    <div class="market" id="market"></div>

</section>


<section id="exchange" class="exchange">

    <div class="card chart">

        <h2 id="chartTitle">Bitcoin (BTC)</h2>

        <p style="color:#8c96a8;margin-top:5px;">
            Price movement
        </p>

        <canvas id="chartCanvas"></canvas>

    </div>


    <div class="card trade">

        <h2>Demo Trade</h2>

        <label>Cryptocurrency</label>

        <select id="tradeCoin">
            <option value="bitcoin">Bitcoin</option>
            <option value="ethereum">Ethereum</option>
            <option value="solana">Solana</option>
            <option value="binancecoin">BNB</option>
        </select>

        <label>Amount (USD)</label>

        <input
            type="number"
            id="tradeAmount"
            placeholder="100"
            min="1"
        >

        <div class="trade-buttons">

            <button class="buy" onclick="buyCoin()">
                BUY
            </button>

            <button class="sell" onclick="sellCoin()">
                SELL
            </button>

        </div>

        <div id="tradeMessage"
             style="color:#8c96a8;">
        </div>

    </div>

</section>


<section id="portfolio" class="portfolio">

    <div class="card">

        <h2>My Demo Portfolio</h2>

        <p style="color:#8c96a8;margin-top:10px;">
            Demo balance
        </p>

        <div class="balance" id="balance">
            $10,000.00
        </div>

        <div class="assets">

            <div class="asset">
                <span>Bitcoin</span>
                <span id="btcHolding">0 BTC</span>
            </div>

            <div class="asset">
                <span>Ethereum</span>
                <span id="ethHolding">0 ETH</span>
            </div>

            <div class="asset">
                <span>Solana</span>
                <span id="solHolding">0 SOL</span>
            </div>

            <div class="asset">
                <span>BNB</span>
                <span id="bnbHolding">0 BNB</span>
            </div>

        </div>

    </div>

</section>

</main>


<footer>

    CryptoX Demo © 2026  
    <br><br>
    This website is a demonstration project and does not execute real cryptocurrency transactions.

</footer>


<!-- LOGIN / REGISTER MODAL -->

<div class="modal" id="modal">

    <div class="modal-box">

        <span class="close" onclick="closeModal()">×</span>

        <h2 id="modalTitle">Login</h2>

        <input
            id="email"
            type="email"
            placeholder="Email"
        >

        <input
            id="password"
            type="password"
            placeholder="Password"
        >

        <button onclick="submitAuth()">
            Continue
        </button>

        <p
            id="authMessage"
            style="color:#8c96a8;margin-top:15px;text-align:center;"
        ></p>

    </div>

</div>


<script>

/* =========================
   MARKET DATA
========================= */

const coins = [
    {
        id:"bitcoin",
        symbol:"BTC",
        name:"Bitcoin",
        icon:"₿"
    },
    {
        id:"ethereum",
        symbol:"ETH",
        name:"Ethereum",
        icon:"Ξ"
    },
    {
        id:"solana",
        symbol:"SOL",
        name:"Solana",
        icon:"S"
    },
    {
        id:"binancecoin",
        symbol:"BNB",
        name:"BNB",
        icon:"B"
    }
];

let prices = {};

let history = [];

let balance = 10000;

let holdings = {
    bitcoin:0,
    ethereum:0,
    solana:0,
    binancecoin:0
};


/* =========================
   LOAD PRICES
========================= */

async function loadPrices(){

    try{

        const ids = coins.map(c => c.id).join(",");

        const url =
        `https://api.coingecko.com/api/v3/simple/price?ids=${ids}&vs_currencies=usd&include_24hr_change=true`;

        const response = await fetch(url);

        const data = await response.json();

        prices = data;

        renderMarket();

        drawChart();

    }catch(error){

        console.log(error);

    }

}


/* =========================
   MARKET CARDS
========================= */

function renderMarket(){

    const market =
        document.getElementById("market");

    const search =
        document.getElementById("search")
        .value
        .toLowerCase();

    market.innerHTML = "";

    coins
    .filter(c =>
        c.name.toLowerCase().includes(search) ||
        c.symbol.toLowerCase().includes(search)
    )
    .forEach(c => {

        const data = prices[c.id];

        if(!data) return;

        const price = data.usd;

        const change =
            data.usd_24h_change || 0;

        const direction =
            change >= 0 ? "green" : "red";

        const card = document.createElement("div");

        card.className = "card";

        card.innerHTML = `

            <div class="coin-top">

                <div class="coin">

                    <div class="coin-icon">
                        ${c.icon}
                    </div>

                    <div>
                        <b>${c.name}</b>
                        <small style="color:#778195">
                            ${c.symbol}
                        </small>
                    </div>

                </div>

                <span class="${direction}">
                    ${change.toFixed(2)}%
                </span>

            </div>

            <div class="price">
                $${formatPrice(price)}
            </div>

            <button
                style="
                    margin-top:15px;
                    width:100%;
                    background:#192131;
                    color:white;
                "
                onclick="selectCoin('${c.id}')"
            >
                Trade
            </button>

        `;

        market.appendChild(card);

    });

}


/* =========================
   FORMAT PRICE
========================= */

function formatPrice(price){

    if(price >= 1000)
        return price.toLocaleString(
            "en-US",
            {
                minimumFractionDigits:2,
                maximumFractionDigits:2
            }
        );

    if(price >= 1)
        return price.toFixed(2);

    return price.toFixed(4);

}


/* =========================
   SEARCH
========================= */

function filterCoins(){

    renderMarket();

}


/* =========================
   SELECT COIN
========================= */

function selectCoin(id){

    document.getElementById("tradeCoin").value = id;

    const coin =
        coins.find(c => c.id === id);

    document.getElementById("chartTitle")
        .innerText =
        `${coin.name} (${coin.symbol})`;

    drawChart();

    window.scrollTo({
        top:
        document.getElementById("exchange")
        .offsetTop - 70,

        behavior:"smooth"
    });

}


/* =========================
   DEMO BUY
========================= */

function buyCoin(){

    const id =
        document.getElementById("tradeCoin").value;

    const amount =
        Number(
            document.getElementById("tradeAmount").value
        );

    if(!amount || amount <= 0){

        showTradeMessage(
            "Enter a valid amount.",
            "red"
        );

        return;
    }

    if(amount > balance){

        showTradeMessage(
            "Not enough demo USD balance.",
            "red"
        );

        return;
    }

    const price =
        prices[id]?.usd;

    if(!price){

        showTradeMessage(
            "Price unavailable.",
            "red"
        );

        return;
    }

    const quantity =
        amount / price;

    balance -= amount;

    holdings[id] += quantity;

    updatePortfolio();

    showTradeMessage(
        `Demo BUY completed: ${quantity.toFixed(6)} ${id}`,
        "green"
    );

}


/* =========================
   DEMO SELL
========================= */

function sellCoin(){

    const id =
        document.getElementById("tradeCoin").value;

    const amount =
        Number(
            document.getElementById("tradeAmount").value
        );

    if(!amount || amount <= 0){

        showTradeMessage(
            "Enter a valid amount.",
            "red"
        );

        return;
    }

    const price =
        prices[id]?.usd;

    if(!price){

        showTradeMessage(
            "Price unavailable.",
            "red"
        );

        return;
    }

    const quantity =
        amount / price;

    if(holdings[id] < quantity){

        showTradeMessage(
            "Not enough demo crypto.",
            "red"
        );

        return;
    }

    holdings[id] -= quantity;

    balance += amount;

    updatePortfolio();

    showTradeMessage(
        `Demo SELL completed: ${quantity.toFixed(6)} ${id}`,
        "green"
    );

}


/* =========================
   TRADE MESSAGE
========================= */

function showTradeMessage(text,color){

    const el =
        document.getElementById("tradeMessage");

    el.innerText = text;

    el.className = color;

}


/* =========================
   PORTFOLIO
========================= */

function updatePortfolio(){

    document.getElementById("balance")
        .innerText =
        "$" + balance.toLocaleString(
            "en-US",
            {
                minimumFractionDigits:2,
                maximumFractionDigits:2
            }
        );

    document.getElementById("btcHolding")
        .innerText =
        holdings.bitcoin.toFixed(6) + " BTC";

    document.getElementById("ethHolding")
        .innerText =
        holdings.ethereum.toFixed(6) + " ETH";

    document.getElementById("solHolding")
        .innerText =
        holdings.solana.toFixed(6) + " SOL";

    document.getElementById("bnbHolding")
        .innerText =
        holdings.binancecoin.toFixed(6) + " BNB";

}


/* =========================
   SIMPLE CHART
========================= */

function drawChart(){

    const canvas =
        document.getElementById("chartCanvas");

    const ctx =
        canvas.getContext("2d");

    const width =
        canvas.width =
        canvas.clientWidth * 2;

    const height =
        canvas.height =
        320 * 2;

    ctx.clearRect(
        0,
        0,
        width,
        height
    );

    const id =
        document.getElementById("tradeCoin").value;

    const price =
        prices[id]?.usd;

    if(!price) return;

    history.push(price);

    if(history.length > 30)
        history.shift();

    if(history.length < 2){

        ctx.font = "30px Arial";

        ctx.fillText(
            "$" + formatPrice(price),
            40,
            100
        );

        return;

    }

    const min =
        Math.min(...history);

    const max =
        Math.max(...history);

    const range =
        max - min || 1;

    ctx.beginPath();

    history.forEach((value,index)=>{

        const x =
            index *
            (width / (history.length - 1));

        const y =
            height -
            ((value - min) / range) *
            (height - 50);

        if(index === 0)
            ctx.moveTo(x,y);
        else
            ctx.lineTo(x,y);

    });

    ctx.lineWidth = 5;

    ctx.strokeStyle = "#00d4ff";

    ctx.stroke();

}


/* =========================
   AUTH DEMO
========================= */

let authMode = "login";

function openModal(mode){

    authMode = mode;

    document.getElementById("modal")
        .style.display = "flex";

    document.getElementById("modalTitle")
        .innerText =
        mode === "login"
        ? "Login"
        : "Create Account";

    document.getElementById("authMessage")
        .innerText = "";

}


function closeModal(){

    document.getElementById("modal")
        .style.display = "none";

}


function submitAuth(){

    const email =
        document.getElementById("email")
        .value;

    const password =
        document.getElementById("password")
        .value;

    if(!email || !password){

        document.getElementById("authMessage")
            .innerText =
            "Please enter email and password.";

        return;
    }

    /*
       DEMO ONLY

       This does NOT create a real
       secure account.

       Real authentication needs
       a backend/database.
    */

    localStorage.setItem(
        "demoUser",
        email
    );

    document.getElementById("authMessage")
        .innerText =
        authMode === "login"
        ? "Demo login successful."
        : "Demo account created.";

}


/* =========================
   INITIAL LOAD
========================= */

loadPrices();

setInterval(
    loadPrices,
    30000
);

setInterval(
    drawChart,
    10000
);

</script>

</body>
</html>
