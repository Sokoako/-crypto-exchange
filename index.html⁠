<!DOCTYPE html>
<html lang="ka">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>cxadniaki</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
    font-family:Arial,sans-serif;
}

body{
    background:#f0f2f5;
    color:#1c1e21;
}

/* HEADER */
header{
    height:60px;
    background:white;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 25px;
    box-shadow:0 1px 4px #ccc;
    position:sticky;
    top:0;
    z-index:100;
}

.logo{
    font-size:25px;
    font-weight:bold;
    color:#1877f2;
}

.search{
    width:300px;
    background:#f0f2f5;
    border:0;
    border-radius:20px;
    padding:11px 16px;
    outline:none;
}

.header-buttons{
    display:flex;
    gap:8px;
}

.header-buttons button{
    border:0;
    border-radius:8px;
    padding:10px 15px;
    cursor:pointer;
    font-weight:bold;
}

.login{
    background:#e4e6eb;
}

.signup{
    background:#1877f2;
    color:white;
}

/* LAYOUT */
.container{
    max-width:1200px;
    margin:auto;
    display:grid;
    grid-template-columns:240px 1fr 240px;
    gap:20px;
    padding:20px;
}

/* SIDEBARS */
.sidebar,
.rightbar{
    background:white;
    border-radius:10px;
    padding:15px;
    height:max-content;
}

.menu{
    padding:12px;
    border-radius:8px;
    cursor:pointer;
    margin-bottom:5px;
}

.menu:hover{
    background:#f0f2f5;
}

/* PROFILE */
.profile{
    background:white;
    border-radius:10px;
    margin-bottom:15px;
    overflow:hidden;
}

.cover{
    height:150px;
    background:linear-gradient(135deg,#1877f2,#6c5ce7);
}

.profile-info{
    padding:15px;
    text-align:center;
}

.avatar{
    width:90px;
    height:90px;
    border-radius:50%;
    background:#ddd;
    margin:-60px auto 10px;
    border:5px solid white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:40px;
}

/* CREATE POST */
.create-post{
    background:white;
    padding:15px;
    border-radius:10px;
    margin-bottom:15px;
}

.post-input{
    width:100%;
    padding:14px;
    border:0;
    background:#f0f2f5;
    border-radius:20px;
    outline:none;
}

.post-actions{
    display:flex;
    justify-content:space-around;
    margin-top:15px;
}

.post-actions button{
    border:0;
    background:white;
    padding:10px 20px;
    border-radius:8px;
    cursor:pointer;
}

.post-actions button:hover{
    background:#f0f2f5;
}

/* POST */
.post{
    background:white;
    border-radius:10px;
    padding:15px;
    margin-bottom:15px;
}

.post-header{
    display:flex;
    align-items:center;
    gap:10px;
}

.small-avatar{
    width:42px;
    height:42px;
    background:#ddd;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
}

.post-text{
    margin:15px 0;
    font-size:16px;
}

.post-buttons{
    display:flex;
    border-top:1px solid #ddd;
    padding-top:8px;
}

.post-buttons button{
    flex:1;
    background:white;
    border:0;
    padding:10px;
    cursor:pointer;
    border-radius:7px;
}

.post-buttons button:hover{
    background:#f0f2f5;
}

.liked{
    color:#1877f2;
    font-weight:bold;
}

/* COMMENTS */
.comments{
    margin-top:10px;
}

.comment{
    background:#f0f2f5;
    border-radius:15px;
    padding:8px 12px;
    margin-top:7px;
}

.comment-box{
    display:flex;
    gap:5px;
    margin-top:10px;
}

.comment-box input{
    flex:1;
    border:0;
    background:#f0f2f5;
    padding:10px;
    border-radius:20px;
    outline:none;
}

.comment-box button{
    border:0;
    background:#1877f2;
    color:white;
    border-radius:20px;
    padding:0 15px;
}

/* FRIENDS */
.friend{
    display:flex;
    align-items:center;
    gap:10px;
    padding:10px 0;
}

.friend-avatar{
    width:38px;
    height:38px;
    border-radius:50%;
    background:#ddd;
    display:flex;
    align-items:center;
    justify-content:center;
}

/* MODAL */
.modal{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.6);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:500;
}

.modal-box{
    width:90%;
    max-width:400px;
    background:white;
    padding:25px;
    border-radius:12px;
}

.modal-box h2{
    margin-bottom:20px;
}

.modal-box input{
    width:100%;
    padding:13px;
    margin-bottom:12px;
    border:1px solid #ddd;
    border-radius:7px;
}

.modal-box button{
    width:100%;
    padding:13px;
    border:0;
    background:#1877f2;
    color:white;
    border-radius:7px;
    font-weight:bold;
}

.close{
    float:right;
    cursor:pointer;
    font-size:22px;
}

/* CHAT */
.chat{
    position:fixed;
    right:20px;
    bottom:20px;
    width:300px;
    background:white;
    border-radius:10px;
    box-shadow:0 3px 20px #aaa;
    display:none;
    overflow:hidden;
}

.chat-header{
    background:#1877f2;
    color:white;
    padding:13px;
    font-weight:bold;
}

.chat-messages{
    height:250px;
    padding:10px;
    overflow-y:auto;
}

.chat-input{
    display:flex;
    border-top:1px solid #ddd;
}

.chat-input input{
    flex:1;
    border:0;
    padding:12px;
    outline:none;
}

.chat-input button{
    border:0;
    background:#1877f2;
    color:white;
    padding:0 15px;
}

/* MOBILE */
@media(max-width:900px){

    .container{
        grid-template-columns:1fr;
    }

    .sidebar,
    .rightbar{
        display:none;
    }

    .search{
        width:180px;
    }

}

@media(max-width:500px){

    header{
        padding:0 10px;
    }

    .logo{
        font-size:20px;
    }

    .search{
        display:none;
    }

    .header-buttons button{
        padding:8px 10px;
    }

    .container{
        padding:10px;
    }

    .chat{
        width:calc(100% - 30px);
        right:15px;
        bottom:15px;
    }
}
</style>
</head>

<body>

<!-- HEADER -->
<header>

    <div class="logo">cxadniaki</div>

    <input
        class="search"
        id="search"
        placeholder="მოძებნე..."
        oninput="searchPosts()"
    >

    <div class="header-buttons">
        <button class="login" onclick="openAuth('login')">
            შესვლა
        </button>

        <button class="signup" onclick="openAuth('signup')">
            რეგისტრაცია
        </button>
    </div>

</header>


<!-- MAIN -->
<div class="container">

    <!-- LEFT -->
    <aside class="sidebar">

        <div class="menu">🏠 მთავარი</div>
        <div class="menu">👤 ჩემი პროფილი</div>
        <div class="menu">👥 მეგობრები</div>
        <div class="menu" onclick="openChat()">💬 Messenger</div>
        <div class="menu">🔔 შეტყობინებები</div>
        <div class="menu">⚙️ პარამეტრები</div>

    </aside>


    <!-- FEED -->
    <main>

        <!-- PROFILE -->
        <div class="profile">

            <div class="cover"></div>

            <div class="profile-info">

                <div class="avatar">👤</div>

                <h2 id="profileName">cxadniaki User</h2>

                <p style="color:#65676b;margin-top:5px;">
                    მოგესალმები cxadniaki-ზე
                </p>

            </div>

        </div>


        <!-- CREATE POST -->
        <div class="create-post">

            <input
                class="post-input"
                id="postInput"
                placeholder="რას ფიქრობ?"
            >

            <div class="post-actions">

                <button onclick="createPost()">
                    📝 პოსტი
                </button>

                <button onclick="alert('ფოტოს დამატება მალე იქნება')">
                    📷 ფოტო
                </button>

                <button onclick="alert('ვიდეოს დამატება მალე იქნება')">
                    🎥 ვიდეო
                </button>

            </div>

        </div>


        <!-- POSTS -->
        <div id="feed">

            <div class="post">

                <div class="post-header">

                    <div class="small-avatar">
                        👤
                    </div>

                    <div>
                        <b>cxadniaki</b>
                        <p style="color:#65676b;font-size:12px;">
                            ცოტა ხნის წინ
                        </p>
                    </div>

                </div>

                <div class="post-text">
                    მოგესალმებით cxadniaki-ზე! 🚀
                </div>

                <div class="post-buttons">

                    <button onclick="likePost(this)">
                        👍 მოწონება
                    </button>

                    <button onclick="focusComment(this)">
                        💬 კომენტარი
                    </button>

                    <button onclick="sharePost()">
                        ↗️ გაზიარება
                    </button>

                </div>

                <div class="comments">

                    <div class="comment">
                        წარმატებები! 🔥
                    </div>

                </div>

                <div class="comment-box">

                    <input
                        placeholder="დაწერე კომენტარი..."
                    >

                    <button onclick="addComment(this)">
                        გაგზავნა
                    </button>

                </div>

            </div>


            <div class="post">

                <div class="post-header">

                    <div class="small-avatar">
                        😎
                    </div>

                    <div>
                        <b>Gio</b>
                        <p style="color:#65676b;font-size:12px;">
                            1 საათის წინ
                        </p>
                    </div>

                </div>

                <div class="post-text">
                    როგორ მოგწონთ ახალი cxadniaki? ❤️
                </div>

                <div class="post-buttons">

                    <button onclick="likePost(this)">
                        👍 მოწონება
                    </button>

                    <button onclick="focusComment(this)">
                        💬 კომენტარი
                    </button>

                    <button onclick="sharePost()">
                        ↗️ გაზიარება
                    </button>

                </div>

                <div class="comments"></div>

                <div class="comment-box">

                    <input
                        placeholder="დაწერე კომენტარი..."
                    >

                    <button onclick="addComment(this)">
                        გაგზავნა
                    </button>

                </div>

            </div>

        </div>

    </main>


    <!-- RIGHT -->
    <aside class="rightbar">

        <h3>მეგობრები</h3>

        <div class="friend">

            <div class="friend-avatar">😎</div>

            <span>Gio</span>

        </div>

        <div class="friend">

            <div class="friend-avatar">🙂</div>

            <span>Nika</span>

        </div>

        <div class="friend">

            <div class="friend-avatar">🔥</div>

            <span>Dato</span>

        </div>

        <hr style="margin:15px 0;border:0;border-top:1px solid #ddd;">

        <h3>ონლაინ</h3>

        <p style="margin-top:12px;color:#31a24c;">
            🟢 3 მეგობარი ონლაინ
        </p>

    </aside>

</div>


<!-- AUTH MODAL -->
<div class="modal" id="authModal">

    <div class="modal-box">

        <span class="close" onclick="closeAuth()">×</span>

        <h2 id="authTitle">შესვლა</h2>

        <input
            id="authName"
            placeholder="სახელი"
        >

        <input
            id="authEmail"
            type="email"
            placeholder="Email"
        >

        <input
            id="authPassword"
            type="password"
            placeholder="პაროლი"
        >

        <button onclick="authSubmit()">
            გაგრძელება
        </button>

        <p
            id="authMessage"
            style="text-align:center;margin-top:12px;color:#65676b;"
        ></p>

    </div>

</div>


<!-- CHAT -->
<div class="chat" id="chat">

    <div class="chat-header">
        💬 Messenger
        <span
            onclick="closeChat()"
            style="float:right;cursor:pointer;"
        >
            ×
        </span>
    </div>

    <div class="chat-messages" id="chatMessages">

        <div class="comment">
            გამარჯობა 👋
        </div>

    </div>

    <div class="chat-input">

        <input
            id="chatInput"
            placeholder="დაწერე..."
            onkeydown="if(event.key==='Enter') sendMessage()"
        >

        <button onclick="sendMessage()">
            ➤
        </button>

    </div>

</div>


<script>

/* AUTH */

let authMode="login";

function openAuth(mode){

    authMode=mode;

    document.getElementById("authModal")
        .style.display="flex";

    document.getElementById("authTitle")
        .innerText =
        mode==="login"
        ? "შესვლა"
        : "რეგისტრაცია";

    document.getElementById("authName")
        .style.display =
        mode==="login"
        ? "none"
        : "block";

}

function closeAuth(){

    document.getElementById("authModal")
        .style.display="none";

}

function authSubmit(){

    const name =
        document.getElementById("authName").value;

    const email =
        document.getElementById("authEmail").value;

    const password =
        document.getElementById("authPassword").value;

    if(!email || !password){

        document.getElementById("authMessage")
            .innerText="შეავსე ყველა აუცილებელი ველი.";

        return;
    }

    if(authMode==="signup" && name){

        document.getElementById("profileName")
            .innerText=name;

        localStorage.setItem(
            "cxadniakiUser",
            name
        );

    }

    document.getElementById("authMessage")
        .innerText =
        authMode==="login"
        ? "შესვლა წარმატებულია ✅"
        : "რეგისტრაცია წარმატებულია ✅";

}


/* CREATE POST */

function createPost(){

    const input =
        document.getElementById("postInput");

    const text =
        input.value.trim();

    if(!text){

        alert("დაწერე რამე.");

        return;
    }

    const post =
        document.createElement("div");

    post.className="post";

    post.innerHTML=`

        <div class="post-header">

            <div class="small-avatar">
                👤
            </div>

            <div>
                <b>cxadniaki User</b>
                <p style="color:#65676b;font-size:12px;">
                    ახლა
                </p>
            </div>

        </div>

        <div class="post-text">
            ${escapeHTML(text)}
        </div>

        <div class="post-buttons">

            <button onclick="likePost(this)">
                👍 მოწონება
            </button>

            <button onclick="focusComment(this)">
                💬 კომენტარი
            </button>

            <button onclick="sharePost()">
                ↗️ გაზიარება
            </button>

        </div>

        <div class="comments"></div>

        <div class="comment-box">

            <input placeholder="დაწერე კომენტარი...">

            <button onclick="addComment(this)">
                გაგზავნა
            </button>

        </div>
    `;

    document
        .getElementById("feed")
        .prepend(post);

    input.value="";

}


/* LIKE */

function likePost(button){

    button.classList.toggle("liked");

    if(button.classList.contains("liked")){

        button.innerText="👍 მოწონებულია";

    }else{

        button.innerText="👍 მოწონება";

    }

}


/* COMMENT */

function addComment(button){

    const box =
        button.parentElement;

    const input =
        box.querySelector("input");

    const text =
        input.value.trim();

    if(!text) return;

    const comments =
        box.parentElement
        .querySelector(".comments");

    const comment =
        document.createElement("div");

    comment.className="comment";

    comment.innerHTML =
        "👤 <b>თქვენ:</b> "
        + escapeHTML(text);

    comments.appendChild(comment);

    input.value="";

}


/* FOCUS COMMENT */

function focusComment(button){

    const post =
        button.closest(".post");

    const input =
        post.querySelector(".comment-box input");

    input.focus();

}


/* SHARE */

function sharePost(){

    alert(
        "პოსტის გაზიარება მალე დაემატება 🚀"
    );

}


/* SEARCH */

function searchPosts(){

    const query =
        document.getElementById("search")
        .value
        .toLowerCase();

    document
        .querySelectorAll(".post")
        .forEach(post=>{

            const text =
                post.innerText.toLowerCase();

            post.style.display =
                text.includes(query)
                ? "block"
                : "none";

        });

}


/* CHAT */

function openChat(){

    document.getElementById("chat")
        .style.display="block";

}

function closeChat(){

    document.getElementById("chat")
        .style.display="none";

}

function sendMessage(){

    const input =
        document.getElementById("chatInput");

    const text =
        input.value.trim();

    if(!text) return;

    const message =
        document.createElement("div");

    message.className="comment";

    message.innerText =
        "თქვენ: " + text;

    document
        .getElementById("chatMessages")
        .appendChild(message);

    input.value="";

}


/* SECURITY */

function escapeHTML(text){

    const div =
        document.createElement("div");

    div.textContent=text;

    return div.innerHTML;

}


/* LOAD USER */

const savedUser =
    localStorage.getItem("cxadniakiUser");

if(savedUser){

    document.getElementById("profileName")
        .innerText=savedUser;

}

</script>

</body>
</html>
