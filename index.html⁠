<script>

/* =====================================================
   COINS
===================================================== */

const coins = {

    bitcoin:{
        name:"Bitcoin",
        symbol:"BTC",
        icon:"₿"
    },

    ethereum:{
        name:"Ethereum",
        symbol:"ETH",
        icon:"Ξ"
    },

    solana:{
        name:"Solana",
        symbol:"SOL",
        icon:"S"
    },

    binancecoin:{
        name:"BNB",
        symbol:"BNB",
        icon:"B"
    },

    ripple:{
        name:"XRP",
        symbol:"XRP",
        icon:"X"
    }

};


/* =====================================================
   STATE
===================================================== */

let prices = {};

let historyPrices = [];

let balance =
    Number(
        localStorage.getItem("cx_balance")
    ) || 10000;

let holdings =
    JSON.parse(
        localStorage.getItem("cx_holdings")
    ) || {

        bitcoin:0,
        ethereum:0,
        solana:0,
        binancecoin:0,
        ripple:0

    };

let transactions =
    JSON.parse(
        localStorage.getItem("cx_transactions")
    ) || [];


/* =====================================================
   PAGE NAVIGATION
===================================================== */

function showPage(page,button){

    document
        .querySelectorAll(".page")
        .forEach(p=>{
            p.classList.remove("active");
        });

    const target =
        document.getElementById(page);

    if(target)
        target.classList.add("active");


    document
        .querySelectorAll(".nav-btn")
        .forEach(b=>{
            b.classList.remove("active");
        });


    document
        .querySelectorAll(".mobile-nav button")
        .forEach(b=>{
            b.classList.remove("active");
        });


    if(button)
        button.classList.add("active");


    window.scrollTo({
        top:0,
        behavior:"smooth"
    });

}


/* =====================================================
   FETCH LIVE PRICES
===================================================== */

async function loadPrices(){

    try{

        const ids =
            Object.keys(coins).join(",");

        const url =
        "https://api.coingecko.com/api/v3/simple/price"
        +
        "?ids="
        + ids
        +
        "&vs_currencies=usd"
        +
        "&include_24hr_change=true";


        const response =
            await fetch(url);

        const data =
            await response.json();

        prices=data;


        renderMarkets();

        renderDashboard();

        updateWallet();

        updateTrade();

    }catch(error){

        console.log(error);

        showToast(
            "Market data unavailable"
        );

    }

}


/* =====================================================
   FORMAT
===================================================== */

function money(value){

    return Number(value).toLocaleString(
        "en-US",
        {
            minimumFractionDigits:2,
            maximumFractionDigits:2
        }
    );

}


function coinPrice(value){

    if(value >= 1000)
        return money(value);

    if(value >= 1)
        return value.toFixed(2);

    return value.toFixed(5);

}


/* =====================================================
   MARKETS
===================================================== */

function renderMarkets(){

    const table =
        document.getElementById("marketsTable");

    const search =
        (
            document.getElementById("coinSearch")
            ?.value || ""
        ).toLowerCase();


    table.innerHTML = `

        <div class="market-row market-header">

            <div>ASSET</div>
            <div>PRICE</div>
            <div>24H CHANGE</div>
            <div>ACTION</div>

        </div>

    `;


    Object.entries(coins)
    .filter(([id,c])=>{

        return (
            c.name.toLowerCase().includes(search)
            ||
            c.symbol.toLowerCase().includes(search)
        );

    })
    .forEach(([id,c])=>{

        const data=prices[id];

        if(!data)
            return;


        const change =
