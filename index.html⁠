<!DOCTYPE html>
<html lang="ka">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NEXUS PAY - Crypto Platform</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            background-color: #07090e;
            color: #f3f4f6;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }
    </style>
</head>
<body class="min-h-screen p-4 md:p-8">

    <!-- Top Navigation -->
    <header class="max-w-6xl mx-auto flex justify-between items-center mb-10 border-b border-slate-800/60 pb-4">
        <div class="flex items-center gap-3">
            <div class="bg-gradient-to-tr from-emerald-500 to-cyan-500 p-2.5 rounded-xl shadow-lg shadow-emerald-500/20">
                <svg class="w-6 h-6 text-slate-950" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <span class="font-extrabold text-xl tracking-wider bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">
                NEXUS PAY
            </span>
        </div>
        <div class="flex items-center gap-2 bg-slate-900/80 border border-slate-800 px-4 py-2 rounded-full text-sm">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-slate-400">Network:</span>
            <span class="font-medium text-emerald-400">Mainnet Secure</span>
        </div>
    </header>

    <main class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Balance Card & Quick Stats -->
        <div class="lg:col-span-1 space-y-6">
            <div class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-slate-900/90 to-slate-950 border border-slate-800/80 rounded-3xl p-6 shadow-2xl">
                <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-emerald-500/10 rounded-full blur-3xl"></div>
                <p class="text-sm font-medium text-slate-400 mb-1">ჯამური ბალანსი</p>
                <h2 id="totalBalance" class="text-4xl font-black tracking-tight text-white mb-6">$5,432.50</h2>
                <div class="grid grid-cols-2 gap-3">
                    <div class="bg-slate-800/40 border border-slate-700/50 p-3 rounded-2xl">
                        <span class="text-xs text-slate-400 block mb-1">აქტიური აქტივი</span>
                        <span class="text-lg font-bold text-emerald-400">94.2%</span>
                    </div>
                    <div class="bg-slate-800/40 border border-slate-700/50 p-3 rounded-2xl">
                        <span class="text-xs text-slate-400 block mb-1">უსაფრთხოება</span>
                        <span class="text-lg font-bold text-cyan-400 flex items-center gap-1">100%</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Deposit & Withdrawal Interface -->
        <div class="lg:col-span-2 bg-slate-900/60 backdrop-blur-xl border border-slate-800/80 rounded-3xl p-6 md:p-8 shadow-2xl flex flex-col justify-between">
            <div>
                <div class="flex bg-slate-950/60 p-1.5 rounded-2xl border border-slate-800 mb-6">
                    <button onclick="switchTab('deposit')" id="depositTabBtn" class="flex-1 py-3 rounded-xl font-semibold text-sm transition-all duration-300 bg-emerald-500 text-slate-950 shadow-lg shadow-emerald-500/20">
                        თანხის შეტანა
                    </button>
                    <button onclick="switchTab('withdraw')" id="withdrawTabBtn" class="flex-1 py-3 rounded-xl font-semibold text-sm transition-all duration-300 text-slate-400 hover:text-white">
                        თანხის გატანა
                    </button>
                </div>

                <form id="transactionForm" onsubmit="handleTransaction(event)" class="space-y-5">
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">აირჩიეთ ვალუტა</label>
                        <select id="currencySelect" class="w-full bg-slate-950 border border-slate-800 rounded-2xl px-4 py-3.5 text-white font-medium focus:outline-none focus:border-emerald-500 transition-colors">
                            <option value="USDT">USDT (Tether)</option>
                            <option value="BTC">BTC (Bitcoin)</option>
                            <option value="ETH">ETH (Ethereum)</option>
                            <option value="SOL">SOL (Solana)</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">თანხის ოდენობა</label>
                        <div class="relative">
                            <input type="number" step="any" id="amountInput" placeholder="0.00" class="w-full bg-slate-950 border border-slate-800 rounded-2xl pl-4 pr-20 py-3.5 text-white font-bold text-lg focus:outline-none focus:border-emerald-500 transition-colors" required>
                            <div id="currencyBadge" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 font-semibold bg-slate-900 px-3 py-1 rounded-xl text-sm border border-slate-800">
                                USDT
                            </div>
                        </div>
                    </div>

                    <button type="submit" id="submitBtn" class="w-full py-4 rounded-2xl font-bold text-slate-950 tracking-wide transition-all duration-300 shadow-xl bg-gradient-to-r from-emerald-400 to-emerald-500 hover:from-emerald-300 hover:to-emerald-400 shadow-emerald-500/20">
                        ტრანზაქციის დადასტურება (Deposit)
                    </button>
                </form>
            </div>
        </div>
    </main>

    <!-- Transaction History -->
    <section class="max-w-6xl mx-auto mt-10 bg-slate-900/60 backdrop-blur-xl border border-slate-800/80 rounded-3xl p-6 md:p-8 shadow-2xl">
        <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
            ტრანზაქციების ისტორია
        </h3>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-800 text-slate-400 text-xs uppercase tracking-wider">
                        <th class="pb-3 font-semibold">ტიპი</th>
                        <th class="pb-3 font-semibold">ოდენობა</th>
                        <th class="pb-3 font-semibold">თარიღი</th>
                        <th class="pb-3 font-semibold">სტატუსი</th>
                    </tr>
                </thead>
                <tbody id="historyTableBody" class="divide-y divide-slate-800/40 text-sm">
                    <tr class="hover:bg-slate-800/20 transition-colors">
                        <td class="py-4 font-medium text-white">Deposit</td>
                        <td class="py-4 font-bold text-white">+500 USDT</td>
                        <td class="py-4 text-slate-400">2026-06-08 14:20</td>
                        <td class="py-4"><span class="px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Completed</span></td>
                    </tr>
                    <tr class="hover:bg-slate-800/20 transition-colors">
                        <td class="py-4 font-medium text-white">Withdraw</td>
                        <td class="py-4 font-bold text-white">-120 BTC</td>
                        <td class="py-4 text-slate-400">2026-06-07 09:15</td>
                        <td class="py-4"><span class="px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Completed</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <!-- JavaScript Logic -->
    <script>
        let balance = 5432.50;
        let currentTab = 'deposit';

        const currencySelect = document.getElementById('currencySelect');
        const currencyBadge = document.getElementById('currencyBadge');

        currencySelect.addEventListener('change', (e) => {
            currencyBadge.innerText = e.target.value;
        });

        function switchTab(tab) {
            currentTab = tab;
            const depositBtn = document.getElementById('depositTabBtn');
            const withdrawBtn = document.getElementById('withdrawTabBtn');
            const submitBtn = document.getElementById('submitBtn');

            if (tab === 'deposit') {
                depositBtn.className = "flex-1 py-3 rounded-xl font-semibold text-sm transition-all duration-300 bg-emerald-500 text-slate-950 shadow-lg shadow-emerald-500/20";
                withdrawBtn.className = "flex-1 py-3 rounded-xl font-semibold text-sm transition-all duration-300 text-slate-400 hover:text-white";
                submitBtn.className = "w-full py-4 rounded-2xl font-bold text-slate-950 tracking-wide transition-all duration-300 shadow-xl bg-gradient-to-r from-emerald-400 to-emerald-500 hover:from-emerald-300 hover:to-emerald-400 shadow-emerald-500/20";
                submitBtn.innerText = "ტრანზაქციის დადასტურება (Deposit)";
            } else {
                withdrawBtn.className = "flex-1 py-3 rounded-xl font-semibold text-sm transition-all duration-300 bg-cyan-500 text-slate-950 shadow-lg shadow-cyan-500/20";
                depositBtn.className = "flex-1 py-3 rounded-xl font-semibold text-sm transition-all duration-300 text-slate-400 hover:text-white";
                submitBtn.className = "w-full py-4 rounded-2xl font-bold text-slate-950 tracking-wide transition-all duration-300 shadow-xl bg-gradient-to-r from-cyan-400 to-cyan-500 hover:from-cyan-300 hover:to-cyan-400 shadow-cyan-500/20";
                submitBtn.innerText = "გატანის მოთხოვნა (Withdraw)";
            }
        }

        function handleTransaction(e) {
            e.preventDefault();
            const amountInput = document.getElementById('amountInput');
            const val = parseFloat(amountInput.value);
            const currency = currencySelect.value;

            if (!val || val <= 0) return;

            if (currentTab === 'deposit') {
                balance += val;
                addHistoryRow('Deposit', `+${val} ${currency}`, 'Completed');
            } else {
                if (val > balance) {
                    alert('არასაკმარისი ბალანსი!');
                    return;
                }
                balance -= val;
                addHistoryRow('Withdraw', `-${val} ${currency}`, 'Pending');
            }

            document.getElementById('totalBalance').innerText = '$' + balance.toLocaleString('en-US', { minimumFractionDigits: 2 });
            amountInput.value = '';
        }

        function addHistoryRow(type, amount, status) {
            const tbody = document.getElementById('historyTableBody');
            const dateStr = new Date().toISOString().slice(0, 19).replace('T', ' ');
            const statusClass = status === 'Completed' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-amber-500/10 text-amber-400 border border-amber-500/20';

            const row = document.createElement('tr');
            row.className = "hover:bg-slate-800/20 transition-colors";
            row.innerHTML = `
                <td class="py-4 font-medium text-white">${type}</td>
                <td class="py-4 font-bold text-white">${amount}</td>
                <td class="py-4 text-slate-400">${dateStr}</td>
                <td class="py-4"><span class="px-3 py-1 rounded-full text-xs font-semibold ${statusClass}">${status}</span></td>
            `;
            tbody.prepend(row);
        }
    </script>
</body>
</html>
