<!DOCTYPE html>
<html lang="ka">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GreenBox - Mystery Box & Wallet</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            background-color: #f0fdf4;
            color: #14532d;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

    <!-- Header -->
    <header class="border-b border-green-200 bg-white/80 backdrop-blur-md sticky top-0 z-50 px-6 py-4 flex justify-between items-center shadow-sm">
        <div class="flex items-center gap-3">
            <div class="bg-emerald-600 text-white p-2 rounded-xl font-black text-lg shadow-md">GB</div>
            <span class="font-bold text-xl tracking-wider text-emerald-900">GREEN<span class="text-emerald-600">BOX</span></span>
        </div>
        
        <!-- Navigation Tabs -->
        <div class="flex items-center gap-2 bg-green-100/60 p-1 rounded-xl border border-green-200">
            <button onclick="switchTab('game')" id="tabGame" class="px-4 py-2 rounded-lg text-xs font-bold bg-emerald-600 text-white shadow-sm transition-all">თამაში (Boxes)</button>
            <button onclick="switchTab('wallet')" id="tabWallet" class="px-4 py-2 rounded-lg text-xs font-bold text-emerald-800 hover:text-emerald-950 transition-all">საფულე & ბარათი</button>
        </div>

        <div class="bg-white border border-green-200 px-4 py-2 rounded-xl flex items-center gap-2 shadow-sm">
            <span class="text-xs text-emerald-700 font-medium">ბალანსი:</span>
            <span id="userBalance" class="text-base font-black text-emerald-700">$100.00</span>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-4xl w-full mx-auto p-4 md:p-8 flex-1">
        
        <!-- SECTION 1: GAME (Boxes) -->
        <div id="sectionGame" class="space-y-6">
            <div class="text-center py-2">
                <h1 class="text-2xl font-black text-emerald-950 mb-1">აირჩიე და გახსენი ყუთი</h1>
                <p class="text-xs text-emerald-700">გადაიხადე ფული, სცადე ბედი და მოიგე მეტი!</p>
            </div>

            <!-- Box Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                <!-- Box 1 -->
                <div class="bg-white border-2 border-green-200 hover:border-emerald-500 rounded-2xl p-6 text-center shadow-sm transition-all flex flex-col justify-between">
                    <div>
                        <div class="text-4xl mb-3">📦</div>
                        <h3 class="font-bold text-emerald-950 text-base mb-1">მსუბუქი ყუთი</h3>
                        <p class="text-[11px] text-emerald-700 mb-4">შანსი: მოიგე $15-მდე</p>
                    </div>
                    <div>
                        <div class="text-emerald-600 font-black text-lg mb-3">$5.00</div>
                        <button onclick="openBox(5, 'მსუბუქი ყუთი', 15)" class="w-full py-2.5 rounded-xl bg-emerald-100 hover:bg-emerald-600 hover:text-white text-emerald-800 font-bold text-xs transition-all border border-green-200">გახსნა</button>
                    </div>
                </div>

                <!-- Box 2 -->
                <div class="bg-white border-2 border-emerald-500 rounded-2xl p-6 text-center shadow-md transition-all flex flex-col justify-between relative">
                    <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-emerald-600 text-white text-[10px] font-bold px-3 py-0.5 rounded-full uppercase tracking-wider">ჰიტი</div>
                    <div>
                        <div class="text-4xl mb-3">🎁</div>
                        <h3 class="font-bold text-emerald-950 text-base mb-1">სტანდარტული ყუთი</h3>
                        <p class="text-[11px] text-emerald-700 mb-4">შანსი: მოიგე $50-მდე</p>
                    </div>
                    <div>
                        <div class="text-emerald-600 font-black text-lg mb-3">$20.00</div>
                        <button onclick="openBox(20, 'სტანდარტული ყუთი', 50)" class="w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs transition-all shadow-sm">გახსნა</button>
                    </div>
                </div>

                <!-- Box 3 -->
                <div class="bg-white border-2 border-green-200 hover:border-emerald-500 rounded-2xl p-6 text-center shadow-sm transition-all flex flex-col justify-between">
                    <div>
                        <div class="text-4xl mb-3">💎</div>
                        <h3 class="font-bold text-emerald-950 text-base mb-1">პრემიუმ ყუთი</h3>
                        <p class="text-[11px] text-emerald-700 mb-4">შანსი: მოიგე $200-მდე</p>
                    </div>
                    <div>
                        <div class="text-emerald-600 font-black text-lg mb-3">$75.00</div>
                        <button onclick="openBox(75, 'პრემიუმ ყუთი', 200)" class="w-full py-2.5 rounded-xl bg-emerald-100 hover:bg-emerald-600 hover:text-white text-emerald-800 font-bold text-xs transition-all border border-green-200">გახსნა</button>
                    </div>
                </div>
            </div>

            <!-- Result Box -->
            <div class="bg-white border border-green-200 rounded-2xl p-6 text-center shadow-sm">
                <div id="resultBoxText" class="text-base font-bold text-emerald-900 py-3">
                    აირჩიე ყუთი და სცადე ბედი!
                </div>
            </div>
        </div>

        <!-- SECTION 2: WALLET & CARD (Hidden by default) -->
        <div id="sectionWallet" class="hidden space-y-6">
            <div class="bg-white border border-green-200 rounded-2xl p-6 shadow-sm max-w-lg mx-auto">
                <h2 class="text-lg font-black text-emerald-950 mb-4">ბარათის მიბმა და ბალანსის შევსება</h2>
                
                <form onsubmit="handleDeposit(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-emerald-800 mb-1">ბარათის ნომერი</label>
                        <input type="text" placeholder="4000 0000 0000 0000" maxlength="19" class="w-full bg-green-50/50 border border-green-200 rounded-xl px-3.5 py-2.5 text-sm text-emerald-950 focus:outline-none focus:border-emerald-600 font-mono" required>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-emerald-800 mb-1">მოქმედების ვადა</label>
                            <input type="text" placeholder="MM/YY" maxlength="5" class="w-full bg-green-50/50 border border-green-200 rounded-xl px-3.5 py-2.5 text-sm text-emerald-950 focus:outline-none focus:border-emerald-600 font-mono" required>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-emerald-800 mb-1">CVV კოდი</label>
                            <input type="password" placeholder="123" maxlength="3" class="w-full bg-green-50/50 border border-green-200 rounded-xl px-3.5 py-2.5 text-sm text-emerald-950 focus:outline-none focus:border-emerald-600 font-mono" required>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-emerald-800 mb-1">შესატანი თანხა ($)</label>
                        <input type="number" id="depositAmount" placeholder="50" min="1" class="w-full bg-green-50/50 border border-green-200 rounded-xl px-3.5 py-2.5 text-sm text-emerald-950 font-bold focus:outline-none focus:border-emerald-600" required>
                    </div>
                    <button type="submit" class="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-sm transition-all">
                        ბარათის მიბმა და თანხის ჩარიცხვა
                    </button>
                </form>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="border-t border-green-200 bg-white py-4 text-center text-xs text-emerald-700">
        &copy; 2026 GreenBox Platform. ყველა უფლება დაცულია.
    </footer>

    <!-- Script Logic -->
    <script>
        let balance = 100.00;

        function switchTab(tab) {
            const secGame = document.getElementById('sectionGame');
            const secWallet = document.getElementById('sectionWallet');
            const tabGame = document.getElementById('tabGame');
            const tabWallet = document.getElementById('tabWallet');

            if (tab === 'game') {
                secGame.classList.remove('hidden');
                secWallet.classList.add('hidden');
                tabGame.className = "px-4 py-2 rounded-lg text-xs font-bold bg-emerald-600 text-white shadow-sm transition-all";
                tabWallet.className = "px-4 py-2 rounded-lg text-xs font-bold text-emerald-800 hover:text-emerald-950 transition-all";
            } else {
                secWallet.classList.remove('hidden');
                secGame.classList.add('hidden');
                tabWallet.className = "px-4 py-2 rounded-lg text-xs font-bold bg-emerald-600 text-white shadow-sm transition-all";
                tabGame.className = "px-4 py-2 rounded-lg text-xs font-bold text-emerald-800 hover:text-emerald-950 transition-all";
            }
        }

        function updateBalance() {
            document.getElementById('userBalance').innerText = '$' + balance.toFixed(2);
        }

        function openBox(price, boxName, maxWin) {
            const resultBox = document.getElementById('resultBoxText');

            if (balance < price) {
                alert('არასაკმარისი ბალანსი! გადადი „საფულე & ბარათი“ გვერდზე და შეავსე ბალანსი.');
                switchTab('wallet');
                return;
            }

            balance -= price;
            updateBalance();
            resultBox.innerHTML = `<span class="text-emerald-600 animate-pulse">იხსნება ${boxName}... ⏳</span>`;

            setTimeout(() => {
                const win = Math.random() < 0.5 ? 0 : parseFloat((Math.random() * maxWin).toFixed(2));
                balance += win;
                updateBalance();

                if (win > 0) {
                    resultBox.innerHTML = `<span class="text-emerald-700 font-black">🎉 გილოცავ! ${boxName}-ში მოიგე +$${win.toFixed(2)}!</span>`;
                } else {
                    resultBox.innerHTML = `<span class="text-emerald-900 font-semibold">❌ სამწუხაროდ, ეს ყუთი ცარიელი აღმოჩნდა.</span>`;
                }
            }, 1200);
        }

        function handleDeposit(e) {
            e.preventDefault();
            const amt = parseFloat(document.getElementById('depositAmount').value);
            if (!amt || amt <= 0) return;

            balance += amt;
            updateBalance();
            alert(`ბარათი წარმატებით მიება და ბალანსზე დაგემატა +$${amt.toFixed(2)}!`);
            document.getElementById('depositAmount').value = '';
            switchTab('game');
        }
    </script>
</body>
</html>
