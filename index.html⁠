<!DOCTYPE html>
<html lang="ka">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Demo Crypto Exchange</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: sans-serif; }
    body { background-color: #0b0e11; color: #eaecef; padding: 20px; display: flex; justify-content: center; }
    .container { width: 100%; max-width: 480px; background: #181a20; border-radius: 16px; padding: 20px; }
    .header { text-align: center; margin-bottom: 20px; border-bottom: 1px solid #2b313a; padding-bottom: 15px; }
    .header h1 { color: #fcd535; font-size: 20px; }
    .balance-card { background: #2b313a; padding: 15px; border-radius: 12px; margin-bottom: 20px; }
    .balance-title { font-size: 12px; color: #848e9c; }
    .balance-amount { font-size: 22px; font-weight: bold; color: #0ecb81; margin-top: 5px; }
    .crypto-list { margin-bottom: 20px; }
    .crypto-item { display: flex; justify-content: space-between; padding: 12px; border-radius: 8px; background: #1e2329; margin-bottom: 10px; }
    .trade-box { background: #1e2329; padding: 15px; border-radius: 12px; }
    input { width: 100%; padding: 10px; background: #2b313a; border: 1px solid #474d57; border-radius: 6px; color: #fff; margin-bottom: 10px; }
    .btn-group { display: flex; gap: 10px; }
    button { flex: 1; padding: 12px; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; }
    .btn-buy { background: #0ecb81; color: #fff; }
    .btn-sell { background: #f6465d; color: #fff; }
  </style>
</head>
<body>

<div class="container">
  <div class="header">
    <h1>🚀 Demo Crypto Exchange</h1>
  </div>

  <div class="balance-card">
    <div class="balance-title">დემო ბალანსი (USDT)</div>
    <div class="balance-amount" id="balance">10,000.00 $</div>
  </div>

  <div class="crypto-list">
    <div class="crypto-item">
      <div>Bitcoin (BTC)</div>
      <div style="font-weight:bold; color:#0ecb81;">$65,000.00</div>
    </div>
    <div class="crypto-item">
      <div>Ethereum (ETH)</div>
      <div style="font-weight:bold; color:#0ecb81;">$3,500.00</div>
    </div>
  </div>

  <div class="trade-box">
    <input type="number" id="trade-amount" placeholder="რაოდენობა ($)" value="100">
    <div class="btn-group">
      <button class="btn-buy" onclick="trade('BUY')">ყიდვა</button>
      <button class="btn-sell" onclick="trade('SELL')">გაყიდვა</button>
    </div>
  </div>
</div>

<script>
  let balance = 10000;
  function trade(type) {
    let val = parseFloat(document.getElementById('trade-amount').value);
    if (!val || val <= 0) return alert('ჩაწერეთ სწორი თანხა');
    if (type === 'BUY') {
      if (val > balance) return alert('ბალანსი არ გყოფნით');
      balance -= val;
    } else {
      balance += val;
    }
    document.getElementById('balance').innerText = balance.toFixed(2) + ' $';
    alert(type === 'BUY' ? 'წარმატებით იყიდეთ!' : 'წარმატებით გაყიდეთ!');
  }
</script>

</body>
</html>
