<!DOCTYPE html>
<html lang="ka">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NEXUS BOXES - Mystery Box Game</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            background-color: #0b0e14;
            color: #eaecef;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        @keyframes pulse-box {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.03); }
        .box-anim {
            animation: pulse-box 2s infinite ease-in-out;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

    <!-- Header -->
    <header class="border-b border-[#1e2329] bg-[#12161c]/90 backdrop-blur-md sticky top-0 z-50 px-6 py-4 flex justify-between items-center">
        <div class="flex items-center gap-2.5">
            <div class="bg-amber-500 p-2 rounded-lg text-slate-950 font-black text-lg shadow-lg shadow-amber-500/20">NX</div>
            <span class="font-bold text-xl tracking-wider text-white">MYSTERY<span class="text-amber-500">BOX</span></span>
        </div>
        <div class="bg-[#1e2329] border border-[#2d3748] px-4 py-2 rounded-xl flex items-center gap-3">
            <span class="text-xs text-slate-400">ბალანსი:</span>
            <span id="userBalance" class="text-base font-black text-amber-400">$100.00</span>
            <button onclick="addDemoMoney()" class="bg-amber-500/10 hover:bg-amber-500 hover:text-slate-950 text-amber-400 border border-amber-500/30 text-xs px-2.5 py-1 rounded-lg font-bold transition-all">+ $50</button>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-5xl w-full mx-auto p-4 md:p-8 space-y-8">
        
        <!-- Box Selection -->
        <div>
            აირჩიე ყუთი:
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Bronze Box -->
                <div onclick="selectBox('bronze', 10, 'ბრინჯაოს ყუთი')" id="card-bronze" class="cursor-pointer bg-[#12161c] border-2 border-[#1e2329] hover:border-amber-500/50 rounded-2xl p-6 text-center transition-all shadow-xl group">
                    <div class="text-4xl mb-3 box-anim">🥉</div>
                    <h3 class="font-bold text-white text-lg mb-1">ბრინჯაოს ყუთი</h3>
                    <p class="text-xs text-slate-400 mb-4">შანსი: მოიგე $5-მდე ან წააგე</p>
                    <div class="text-amber-400 font-black text-xl mb-4">$10.00</div>
                    <span class="inline-block w-full py-2.5 rounded-xl bg-[#1e2329] group-hover:bg-amber-500 group-hover:text-slate-950 font-bold text-xs transition-all">არჩევა</span>
                </div>

                <!-- Silver Box -->
                <div onclick="selectBox('silver', 25, 'ვერცხლის ყუთი')" id="card-silver" class="cursor-pointer bg-[#12161c] border-2 border-amber-500 rounded-2xl p-6 text-center transition-all shadow-xl group relative overflow-hidden">
                    <div class="absolute top-0 right-0 bg-amber-500 text-slate-950 text-[10px] font-bold px-3 py-1 rounded-bl-xl">პოპულარული</div>
                    <div class="text-4xl mb-3 box-anim">🥈</div>
                    <h3 class="font-bold text-white text-lg mb-1">ვერცხლის ყუთი</h3>
                    <p class="text-xs text-slate-400 mb-4">შანსი: მოიგე $60-მდე</p>
                    <div class="text-amber-400 font-black text-xl mb-4">$25.00</div>
                    <span class="inline-block w-full py-2.5 rounded-xl bg-amber-500 text-slate-950 font-bold text-xs transition-all">არჩევა</span>
                </div>

                <!-- Gold Box -->
                <div onclick="selectBox('gold', 75, 'ოქროს ყუთი')" id="card-gold" class="cursor-pointer bg-[#12161c] border-2 border-[#1e2329] hover:border-amber-500/50 rounded-2xl p-6 text-center transition-all shadow-xl group">
                    <div class="text-4xl mb-3 box-anim">🥇</div>
                    <h3 class="font-bold text-white text-lg mb-1">ოქროს ყუთი</h3>
                    <p class="text-xs text-slate-400 mb-4">შანსი: მოიგე $200-მდე</p>
                    <div class="text-amber-400 font-black text-xl mb-4">$75.00</div>
                    <span class="inline-block w-full py-2.5 rounded-xl bg-[#1e2329] group-hover:bg-amber-500 group-hover:text-slate-950 font-bold text-xs transition-all">არჩევა</span>
                </div>
            </div>
        </div>

        <!-- Opening Arena / Result Box -->
        <div class="bg-[#12161c] border border-[#1e2329] rounded-2xl p-8 text-center shadow-xl relative">
            <div id="selectedBoxInfo" class="text-sm text-slate-400 mb-2">არჩეულია: <strong class="text-white">ვერცხლის ყუთი ($25.00)</strong></div>
            
            <div id="resultDisplay" class="py-8 text-3xl font-black text-white min-h-[120px] flex items-center justify-center">
                🎁 მზად არის გასახსნელად!
            </div>

            <button onclick="openBox()" id="openBtn" class="w-full md:w-auto px-12 py-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-base shadow-lg shadow-amber-500/20 transition-all">
                ყუთის გახსნა ($25)
            </button>
        </div>

        <!-- History Section -->
        <div class="bg-[#12161c] border border-[#1e2329] rounded-2xl p-6 shadow-xl">
            <h3 class="text-sm font-bold text-white mb-4">ბოლო გახსნები</h3>
            <div id="historyList" class="space-y-2.5">
                <div class="text-xs text-slate-500 text-center py-2">ჯერ ისტორია ცარიელია</div>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="border-t border-[#1e2329] bg-[#12161c] py-4 text-center text-xs text-slate-500">
        &copy; 2026 Mystery Box Game. ყველა უფლება დაცულია.
    </footer>

    <!-- Game Logic -->
    <script>
        let balance = 100.00;
        let currentBox = {
            id: 'silver',
            price: 25.00,
            name: 'ვერცხლის ყუთი'
        };

        function selectBox(id, price, name) {
            currentBox = { id, price, name };
            document.getElementById('selectedBoxInfo').innerHTML = `არჩეულია: <strong class="text-white">${name} ($${price.toFixed(2)})</strong>`;
            document.getElementById('openBtn').innerText = `ყუთის გახსნა ($${price})`;
        }

        function addDemoMoney() {
            balance += 50.00;
            updateBalance();
        }

        function updateBalance() {
            document.getElementById('userBalance').innerText = '$' + balance.toFixed(2);
        }

        function openBox() {
            const openBtn = document.getElementById('openBtn');
            const resultDisplay = document.getElementById('resultDisplay');

            if (balance < currentBox.price) {
                alert('არასაკმარისი ბალანსი! დაამატე ბალანსი ღილაკით "+ $50".');
                return;
            }

            // ჩამოეჭრას საფასური
            balance -= currentBox.price;
            updateBalance();

            openBtn.disabled = true;
            openBtn.classList.add('opacity-50', 'cursor-not-allowed');
            resultDisplay.innerHTML = '<span class="animate-pulse text-amber-400">იხსნება... 🎲</span>';

            setTimeout(() => {
                let winAmount = calculateReward(currentBox.id);
                balance += winAmount;
                updateBalance();

                if (winAmount > 0) {
                    resultDisplay.innerHTML = `<span class="text-emerald-400">🎉 მოიგე +$${winAmount.toFixed(2)}!</span>`;
                } else {
                    resultDisplay.innerHTML = `<span class="text-rose-400">❌ სამწუხაროდ, ყუთი ცარიელი აღმოჩნდა.</span>`;
                }

                addHistory(currentBox.name, winAmount, currentBox.price);

                openBtn.disabled = false;
                openBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            }, 1200);
        }

        function calculateReward(boxId) {
            const rand = Math.random() * 100; // 0-დან 100-მდე

            if (boxId === 'bronze') {
                // ფასი: $10
                if (rand < 50) return 0;          // 50% შანსი - წაგება
                if (rand < 85) return 5.00;       // 35% შანსი - ნახევარი თანხა ბრუნდება
                if (rand < 97) return 15.00;      // 12% შანსი - მცირე მოგება
                return 25.00;                     // 3% შანსი - ჯეკპოტი
            } 
            else if (boxId === 'silver') {
                // ფასი: $25
                if (rand < 45) return 0;          // 45% შანსი - წაგება
                if (rand < 80) return 20.00;      // 35% შანსი - თითქმის იბრუნებს
                if (rand < 96) return 45.00;      // 16% შანსი - კარგი მოგება
                return 65.00;                     // 4% შანსი - დიდი ჯეკპოტი
            } 
            else {
                // ფასი: $75 (Gold)
                if (rand < 40) return 0;          // 40% შანსი - წაგება
                if (rand < 75) return 60.00;      // 35% შანსი
                if (rand < 95) return 120.00;     // 20% შანსი
                return 200.00;                    // 5% შანსი - დიდი ჯეკპოტი
            }
        }

        function addHistory(boxName, win, price) {
            const historyList = document.getElementById('historyList');
            if (historyList.children.length === 1 && historyList.children[0].tagName === 'DIV' && historyList.children[0].classList.contains('text-center')) {
                historyList.innerHTML = '';
            }

            const net = win - price;
            const colorClass = net >= 0 ? 'text-emerald-400' : 'text-rose-400';
            const sign = net >= 0 ? '+' : '';

            const row = document.createElement('div');
            row.className = "flex justify-between items-center bg-[#0b0e14] px-4 py-2.5 rounded-xl border border-[#1e2329] text-xs";
            row.innerHTML = `
                <span class="text-slate-300 font-medium">${boxName}</span>
                <span class="${colorClass} font-bold">${sign}$${net.toFixed(2)} (მოგება: $${win.toFixed(2)})</span>
            `;
            
            historyList.prepend(row);

            // შევინარჩუნოთ მაქსიმუმ ბოლო 5 ჩანაწერი
            if (historyList.children.length > 5) {
                historyList.removeChild(historyList.lastChild);
            }
        }
    </script>
</body>
</html>
