<!DOCTYPE html>
<html lang="ka">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crypto Exchange Platform</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    :root {
      --bg-main: #0b0e14;
      --bg-card: #151a23;
      --bg-input: #1e2430;
      --gold: #f3ba2f;
      --gold-hover: #d4af37;
      --text-main: #ffffff;
      --text-sub: #848e9c;
      --border-color: #2b313a;
      --green: #0ecb81;
      --red: #f6465d;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    body { background-color: var(--bg-main); color: var(--text-main); min-height: 100vh; padding-bottom: 40px; }

    /* Header Navigation */
    header {
      background: var(--bg-card);
      border-bottom: 1px solid var(--border-color);
      padding: 15px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .logo {
      font-size: 20px;
      font-weight: 800;
      color: var(--gold);
      letter-spacing: 1px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .user-info { display: flex; align-items: center; gap: 15px; }
    .user-email-text { color: var(--text-sub); font-size: 14px; }

    .container { max-width: 1200px; margin: 25px auto; padding: 0 15px; }

    /* Auth Box */
    .auth-box {
      background: var(--bg-card);
      padding: 35px;
      border-radius: 12px;
      max-width: 420px;
      margin: 60px auto;
      border: 1px solid var(--gold);
      box-shadow: 0 8px 24px rgba(243, 186, 47, 0.08);
      text-align: center;
    }
    .auth-box h2 { font-size: 22px; color: var(--gold); margin-bottom: 20px; }
    
    input {
      width: 100%;
      padding: 12px 15px;
      margin-bottom: 12px;
      background: var(--bg-input);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      color: var(--text-main);
      font-size: 14px;
      outline: none;
      transition: border 0.2s;
    }
    input:focus { border-color: var(--gold); }

    .btn {
      width: 100%;
      padding: 12px;
      border: none;
      border-radius: 6px;
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .btn-gold { background: var(--gold); color: #000; }
    .btn-gold:hover { background: var(--gold-hover); }
    .btn-outline { background: transparent; border: 1px solid var(--gold); color: var(--gold); }
    .btn-outline:hover { background: rgba(243, 186, 47, 0.1); }
    .btn-green { background: var(--green); color: #fff; }
    .btn-red { background: var(--red); color: #fff; }
    .btn-gray { background: #2b313a; color: #fff; }

    .actions-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }

    /* Dashboard Grid */
    .dashboard-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 20px;
      margin-bottom: 25px;
    }
    @media (max-width: 900px) {
      .dashboard-grid { grid-template-columns: 1fr; }
    }

    .card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 20px;
    }
    .card-title {
      font-size: 15px;
      color: var(--text-sub);
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .balance-val { font-size: 32px; font-weight: 800; color: var(--text-main); margin-bottom: 15px; }
    .balance-val span { color: var(--gold); }

    /* Live Prices Table */
    .crypto-table { width: 100%; border-collapse: collapse; margin-top: 10px; }
    .crypto-table th { text-align: left; color: var(--text-sub); font-size: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color); }
    .crypto-table td { padding: 12px 0; border-bottom: 1px solid var(--border-color); font-size: 14px; }
    .crypto-table tr:last-child td { border-bottom: none; }
    .coin-name { font-weight: 600; display: flex; align-items: center; gap: 8px; }
    .price-up { color: var(--green); }
    .price-down { color: var(--red); }

    /* History Log */
    .history-log { max-height: 200px; overflow-y: auto; }
    .history-item { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border-color); font-size: 13px; color: var(--text-sub); }

    /* Chart Container */
    .chart-container { height: 380px; width: 100%; border-radius: 8px; overflow: hidden; margin-bottom: 20px; border: 1px solid var(--border-color); }

    .hidden { display: none !important; }
  </style>
</head>
<body>

  <!-- Header -->
  <header>
    <div class="logo">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f3ba2f" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
      GOLDEX
    </div>
    <div id="user-header" class="user-info hidden">
      <span class="user-email-text" id="user-email"></span>
      <button class="btn btn-outline" style="width: auto; padding: 6px 15px;" onclick="signOut()">გამოსვლა</button>
    </div>
  </header>

  <div class="container">

    <!-- Auth View -->
    <div id="auth-section" class="auth-box">
      <h2>სისტემაში შესვლა</h2>
      <input type="email" id="email" placeholder="ელ-ფოსტა">
      <input type="password" id="password" placeholder="პაროლი">
      <div class="actions-grid" style="margin-top: 15px;">
        <button class="btn btn-gold" onclick="signIn()">შესვლა</button>
        <button class="btn btn-outline" onclick="signUp()">რეგისტრაცია</button>
      </div>
    </div>

    <!-- Main Trading Dashboard View -->
    <div id="app-section" class="hidden">

      <div class="dashboard-grid">
        <!-- Left Column: TradingView Chart & Wallet -->
        <div>
          <!-- Interactive TradingView Chart -->
          <div class="chart-container">
            <!-- TradingView Widget BEGIN -->
            <div class="tradingview-widget-container" style="height:100%;width:100%">
              <div id="tradingview_chart" style="height:calc(100% - 32px);width:100%"></div>
              <script type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>
              <script type="text/javascript">
              new TradingView.widget({
                "autosize": true,
                "symbol": "BINANCE:BTCUSDT",
                "interval": "D",
                "timezone": "Etc/UTC",
                "theme": "dark",
                "style": "1",
                "locale": "en",
                "toolbar_bg": "#151a23",
                "enable_publishing": false,
                "hide_side_toolbar": false,
                "container_id": "tradingview_chart"
              });
              </script>
            </div>
            <!-- TradingView Widget END -->
          </div>

          <!-- History -->
          <div class="card">
            <div class="card-title">ტრანზაქციების ისტორია</div>
            <div class="history-log" id="history-log">
              <div style="text-align: center; color: var(--text-sub); padding: 15px;">ისტორია ცარიელია</div>
            </div>
          </div>
        </div>

        <!-- Right Column: Wallet & Quick Trade -->
        <div>
          <!-- Balance Card -->
          <div class="card" style="margin-bottom: 20px;">
            <div class="card-title">საფულის ბალანსი (USDT)</div>
            <div class="balance-val"><span id="usdt-balance">0.00</span> USDT</div>
            <input type="number" id="amount-input" placeholder="თანხა USDT-ში">
            <div class="actions-grid">
              <button class="btn btn-gold" onclick="deposit()">დეპოზიტი</button>
              <button class="btn btn-outline" onclick="transfer()">გადარიცხვა</button>
            </div>
          </div>

          <!-- Trade Card -->
          <div class="card" style="margin-bottom: 20px;">
            <div class="card-title">სწრაფი თრეიდინგი (BTC)</div>
            <div style="font-size: 14px; margin-bottom: 12px; color: var(--text-sub);">
              მიმდინარე ფასი: <strong id="selected-btc-price" style="color: var(--text-main);">$0.00</strong>
            </div>
            <div class="actions-grid">
              <button class="btn btn-green" onclick="trade('BUY')">ყიდვა (BTC)</button>
              <button class="btn btn-red" onclick="trade('SELL')">გაყიდვა (BTC)</button>
            </div>
          </div>

          <!-- Crypto Market Prices -->
          <div class="card">
            <div class="card-title">ბაზრის ფასები (Live)</div>
            <table class="crypto-table">
              <thead>
                <tr>
                  <th>ვალუტა</th>
                  <th style="text-align: right;">ფასი</th>
                  <th style="text-align: right;">24h</th>
                </tr>
              </thead>
              <tbody id="crypto-table-body">
                <tr><td colspan="3" style="text-align:center; color: var(--text-sub);">იტვირთება...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </div>

<script>
  const SUPABASE_URL = 'https://urhcenpmzlqplorhyyko.supabase.co';
  const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVyaGNlbnBtemxxcGxvcmh5eWtvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg4MDU5NDIsImV4cCI6MjEwNDM4MTk0Mn0.Z5h70dotH0eiljEUtNns-BJjSJu-harBeXcj81AcV3w';
  const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

  let currentProfileId = null;
  let balance = 0;
  let btcPrice = 0;

  async function init() {
    const { data: { session } } = await supabaseClient.auth.getSession();
    if (session) {
      showApp(session.user);
    }
    fetchMarketPrices();
    setInterval(fetchMarketPrices, 15000);
  }

  async function signUp() {
    const email = document.getElementById('email').value;
    const password = document.getElementById('password').value;
    if (!email || !password) return alert('შეიყვანეთ ელ-ფოსტა და პაროლი');
    const { data, error } = await supabaseClient.auth.signUp({ email, password });
    if (error) return alert(error.message);
    
    if (data.user) {
      await supabaseClient.from('profiles').insert([{ balance: 10000 }]);
      alert('რეგისტრაცია წარმატებულია! ახლა გაიარეთ ავტორიზაცია.');
    }
  }

  async function signIn() {
    const email = document.getElementById('email').value;
    const password = document.getElementById('password').value;
    if (!email || !password) return alert('შეიყვანეთ ელ-ფოსტა და პაროლი');
    const { data, error } = await supabaseClient.auth.signInWithPassword({ email, password });
    if (error) return alert(error.message);
    showApp(data.user);
  }

  async function signOut() {
    await supabaseClient.auth.signOut();
    document.getElementById('auth-section').classList.remove('hidden');
    document.getElementById('app-section').classList.add('hidden');
    document.getElementById('user-header').classList.add('hidden');
  }

  async function showApp(user) {
    document.getElementById('auth-section').classList.add('hidden');
    document.getElementById('app-section').classList.remove('hidden');
    document.getElementById('user-header').classList.remove('hidden');
    document.getElementById('user-email').innerText = user.email;

    let { data: profiles } = await supabaseClient.from('profiles').select('*').limit(1);
    if (profiles && profiles.length > 0) {
      currentProfileId = profiles[0].id;
      balance = parseFloat(profiles[0].balance);
    } else {
      const { data: newProfile } = await supabaseClient.from('profiles').insert([{ balance: 10000 }]).select();
      if (newProfile && newProfile.length > 0) {
        currentProfileId = newProfile[0].id;
        balance = 10000;
      }
    }
    updateBalanceUI();
  }

  async function saveBalance(newBalance) {
    balance = newBalance;
    updateBalanceUI();
    if (currentProfileId) {
      await supabaseClient.from('profiles').update({ balance: newBalance }).eq('id', currentProfileId);
    }
  }

  function updateBalanceUI() {
    document.getElementById('usdt-balance').innerText = balance.toFixed(2);
    document.getElementById('amount-input').value = '';
  }

  async function fetchMarketPrices() {
    try {
      const res = await fetch('https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana,binancecoin,ripple,dogecoin&vs_currencies=usd&include_24hr_change=true');
      const data = await res.json();
      
      btcPrice = data.bitcoin.usd;
      document.getElementById('selected-btc-price').innerText = '$' + btcPrice.toLocaleString();

      const coins = [
        { name: 'Bitcoin (BTC)', key: 'bitcoin' },
        { name: 'Ethereum (ETH)', key: 'ethereum' },
        { name: 'Solana (SOL)', key: 'solana' },
        { name: 'BNB (BNB)', key: 'binancecoin' },
        { name: 'XRP (XRP)', key: 'ripple' },
        { name: 'Dogecoin (DOGE)', key: 'dogecoin' }
      ];

      let html = '';
      coins.forEach(coin => {
        const c = data[coin.key];
        const price = c.usd.toLocaleString();
        const change = c.usd_24h_change ? c.usd_24h_change.toFixed(2) : '0.00';
        const changeClass = c.usd_24h_change >= 0 ? 'price-up' : 'price-down';
        const changeSign = c.usd_24h_change >= 0 ? '+' : '';

        html += `
          <tr>
            <td class="coin-name">${coin.name}</td>
            <td style="text-align: right; font-weight: 600;">$${price}</td>
            <td style="text-align: right;" class="${changeClass}">${changeSign}${change}%</td>
          </tr>
        `;
      });

      document.getElementById('crypto-table-body').innerHTML = html;
    } catch (err) {
      console.log('API Error:', err);
    }
  }

  async function deposit() {
    const val = parseFloat(document.getElementById('amount-input').value);
    if (!val || val <= 0) return alert('ჩაწერეთ სწორი თანხა');
    await saveBalance(balance + val);
    addHistory(`დეპოზიტი`, `+${val} USDT`);
  }

  async function transfer() {
    const val = parseFloat(document.getElementById('amount-input').value);
    if (!val || val > balance) return alert('არასაკმარისი ბალანსი');
    await saveBalance(balance - val);
    addHistory(`გადარიცხვა`, `-${val} USDT`);
  }

  async function trade(type) {
    const val = parseFloat(document.getElementById('amount-input').value);
    if (!val || val <= 0) return alert('ჩაწერეთ თანხა');
    if (type === 'BUY' && val > balance) return alert('არასაკმარისი ბალანსი');

    if (type === 'BUY') {
      await saveBalance(balance - val);
      addHistory(`BTC ყიდვა`, `-${val} USDT`);
    } else {
      await saveBalance(balance + val);
      addHistory(`BTC გაყიდვა`, `+${val} USDT`);
    }
  }

  function addHistory(typeText, amountText) {
    const log = document.getElementById('history-log');
    if (log.children.length === 1 && log.children[0].innerText === 'ისტორია ცარიელია') {
      log.innerHTML = '';
    }
    const item = document.createElement('div');
    item.className = 'history-item';
    item.innerHTML = `<span>${new Date().toLocaleTimeString()} - ${typeText}</span><strong style="color: var(--gold);">${amountText}</strong>`;
    log.prepend(item);
  }

  init();
</script>

</body>
</html>
