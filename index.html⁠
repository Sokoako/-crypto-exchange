<!DOCTYPE html>
<html lang="ka">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crypto Trading Platform</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; }
    body { background-color: #0b0e11; color: #eaecef; padding: 20px; }
    .container { max-width: 900px; margin: 0 auto; }
    h1 { text-align: center; color: #fcd535; margin-bottom: 20px; }
    
    .auth-box { background: #1e2329; padding: 20px; border-radius: 8px; max-width: 400px; margin: 0 auto 20px auto; border: 1px solid #2b313a; }
    .auth-box h2 { font-size: 18px; margin-bottom: 15px; text-align: center; }
    
    .dashboard { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 15px; margin-bottom: 20px; }
    .card { background: #1e2329; padding: 20px; border-radius: 8px; border: 1px solid #2b313a; }
    .card h3 { color: #848e9c; font-size: 14px; margin-bottom: 10px; }
    .balance { font-size: 28px; font-weight: bold; color: #0ecb81; }
    
    .actions { display: flex; gap: 10px; margin-top: 15px; }
    button { flex: 1; padding: 10px; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; color: white; }
    .btn-green { background: #0ecb81; }
    .btn-red { background: #f6465d; }
    .btn-blue { background: #16b9e5; }
    .btn-gray { background: #474d57; }
    
    .prices-list, .history { background: #1e2329; border-radius: 8px; padding: 15px; margin-bottom: 20px; }
    .crypto-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #2b313a; }
    .crypto-row:last-child { border: none; }
    
    input { width: 100%; padding: 10px; margin-top: 8px; margin-bottom: 8px; background: #2b313a; border: 1px solid #474d57; border-radius: 4px; color: white; }
    .history-item { font-size: 13px; color: #848e9c; padding: 5px 0; border-bottom: 1px solid #2b313a; }
    .hidden { display: none; }
  </style>
</head>
<body>

<div class="container">
  <h1>Crypto Trading Dashboard</h1>

  <!-- Auth Section -->
  <div id="auth-section" class="auth-box">
    <h2 id="auth-title">ავტორიზაცია / რეგისტრაცია</h2>
    <input type="email" id="email" placeholder="ელ-ფოსტა">
    <input type="password" id="password" placeholder="პაროლი">
    <div class="actions">
      <button class="btn-green" onclick="signUp()">რეგისტრაცია</button>
      <button class="btn-blue" onclick="signIn()">შესვლა</button>
    </div>
  </div>

  <!-- Main App Section -->
  <div id="app-section" class="hidden">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
      <span id="user-email" style="color: #848e9c;"></span>
      <button class="btn-gray" onclick="signOut()" style="max-width: 100px;">გამოსვლა</button>
    </div>

    <div class="dashboard">
      <div class="card">
        <h3>USDT Real Balance (Supabase)</h3>
        <div class="balance" id="usdt-balance">0.00 $</div>
        <input type="number" id="amount-input" placeholder="თანხა (USDT)">
        <div class="actions">
          <button class="btn-green" onclick="deposit()">დეპოზიტი</button>
          <button class="btn-blue" onclick="transfer()">გადარიცხვა</button>
        </div>
      </div>

      <div class="card">
        <h3>სწრაფი თრეიდინგი (BTC)</h3>
        <p id="selected-btc-price">ფასი იტვირთება...</p>
        <div class="actions" style="margin-top: 30px;">
          <button class="btn-green" onclick="trade('BUY')">ყიდვა (BTC)</button>
          <button class="btn-red" onclick="trade('SELL')">გაყიდვა (BTC)</button>
        </div>
      </div>
    </div>

    <div class="prices-list">
      <h3>კრიპტოვალუტის ფასები (Live API)</h3>
      <div class="crypto-row"><span>Bitcoin (BTC)</span><strong id="btc-price">$0.00</strong></div>
      <div class="crypto-row"><span>Ethereum (ETH)</span><strong id="eth-price">$0.00</strong></div>
      <div class="crypto-row"><span>Solana (SOL)</span><strong id="sol-price">$0.00</strong></div>
    </div>

    <div class="history">
      <h3>ტრანზაქციების ისტორია</h3>
      <div id="history-log"></div>
    </div>
  </div>
</div>

<script>
  const SUPABASE_URL = 'https://urhcenpmzlqplorhyyko.supabase.co';
  const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVyaGNlbnBtemxxcGxvcmh5eWtvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg4MDU5NDIsImV4cCI6MjEwNDM4MTk0Mn0.Z5h70dotH0eiljEUtNns-BJjSJu-harBeXcj81AcV3w';
  const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

  let currentProfileId = null;
  let balance = 0;
  let btcPrice = 0;

  async function init() {
    const { data: { session } } = await supabaseClient.auth.getSession();
    if (session) {
      showApp(session.user);
    }
    fetchPrices();
    setInterval(fetchPrices, 15000);
  }

  async function signUp() {
    const email = document.getElementById('email').value;
    const password = document.getElementById('password').value;
    const { data, error } = await supabaseClient.auth.signUp({ email, password });
    if (error) return alert(error.message);
    
    if (data.user) {
      await supabaseClient.from('profiles').insert([{ balance: 10000 }]);
      alert('რეგისტრაცია წარმატებულია! ახლა გაიარეთ ავტორიზაცია.');
    }
  }

  async function signIn() {
    const email = document.getElementById('email').value;
    const password = document.getElementById('password').value;
    const { data, error } = await supabaseClient.auth.signInWithPassword({ email, password });
    if (error) return alert(error.message);
    showApp(data.user);
  }

  async function signOut() {
    await supabaseClient.auth.signOut();
    document.getElementById('auth-section').classList.remove('hidden');
    document.getElementById('app-section').classList.add('hidden');
  }

  async function showApp(user) {
    document.getElementById('auth-section').classList.add('hidden');
    document.getElementById('app-section').classList.remove('hidden');
    document.getElementById('user-email').innerText = user.email;

    let { data: profiles } = await supabaseClient.from('profiles').select('*').limit(1);
    if (profiles && profiles.length > 0) {
      currentProfileId = profiles[0].id;
      balance = parseFloat(profiles[0].balance);
    } else {
      const { data: newProfile } = await supabaseClient.from('profiles').insert([{ balance: 10000 }]).select();
      if (newProfile && newProfile.length > 0) {
        currentProfileId = newProfile[0].id;
        balance = 10000;
      }
    }
    updateBalanceUI();
  }

  async function saveBalance(newBalance) {
    balance = newBalance;
    updateBalanceUI();
    if (currentProfileId) {
      await supabaseClient.from('profiles').update({ balance: newBalance }).eq('id', currentProfileId);
    }
  }

  function updateBalanceUI() {
    document.getElementById('usdt-balance').innerText = balance.toFixed(2) + ' $';
    document.getElementById('amount-input').value = '';
  }

  async function fetchPrices() {
    try {
      const res = await fetch('https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana&vs_currencies=usd');
      const data = await res.json();
      btcPrice = data.bitcoin.usd;
      document.getElementById('btc-price').innerText = '$' + btcPrice;
      document.getElementById('selected-btc-price').innerText = '1 BTC = $' + btcPrice;
      document.getElementById('eth-price').innerText = '$' + data.ethereum.usd;
      document.getElementById('sol-price').innerText = '$' + data.solana.usd;
    } catch (err) {
      console.log('API Error:', err);
    }
  }

  async function deposit() {
    const val = parseFloat(document.getElementById('amount-input').value);
    if (!val || val <= 0) return alert('ჩაწერეთ სწორი თანხა');
    await saveBalance(balance + val);
    addHistory(`დეპოზიტი: +${val} USDT`);
  }

  async function transfer() {
    const val = parseFloat(document.getElementById('amount-input').value);
    if (!val || val > balance) return alert('არასაკმარისი ბალანსი');
    await saveBalance(balance - val);
    addHistory(`გადარიცხვა: -${val} USDT`);
  }

  async function trade(type) {
    const val = parseFloat(document.getElementById('amount-input').value);
    if (!val || val <= 0) return alert('ჩაწერეთ თანხა');
    if (type === 'BUY' && val > balance) return alert('არასაკმარისი ბალანსი');

    if (type === 'BUY') {
      await saveBalance(balance - val);
      addHistory(`BTC ყიდვა: ${val} USDT`);
    } else {
      await saveBalance(balance + val);
      addHistory(`BTC გაყიდვა: +${val} USDT`);
    }
  }

  function addHistory(text) {
    const log = document.getElementById('history-log');
    const item = document.createElement('div');
    item.className = 'history-item';
    item.innerText = `${new Date().toLocaleTimeString()} - ${text}`;
    log.prepend(item);
  }

  init();
</script>

</body>
</html>
