<!DOCTYPE html>
<html lang="ka">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crypto Trading Platform</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; }
    body { background-color: #0b0e11; color: #eaecef; padding: 20px; }
    .container { max-width: 900px; margin: 0 auto; }
    h1 { text-align: center; color: #fcd535; margin-bottom: 20px; }
    
    .dashboard { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 15px; margin-bottom: 20px; }
    .card { background: #1e2329; padding: 20px; border-radius: 8px; border: 1px solid #2b313a; }
    .card h3 { color: #848e9c; font-size: 14px; margin-bottom: 10px; }
    .balance { font-size: 28px; font-weight: bold; color: #0ecb81; }
    
    .actions { display: flex; gap: 10px; margin-top: 15px; }
    button { flex: 1; padding: 10px; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; color: white; }
    .btn-green { background: #0ecb81; }
    .btn-red { background: #f6465d; }
    .btn-blue { background: #16b9e5; }
    
    .prices-list { background: #1e2329; border-radius: 8px; padding: 15px; margin-bottom: 20px; }
    .crypto-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #2b313a; }
    .crypto-row:last-child { border: none; }
    
    input { width: 100%; padding: 10px; margin-top: 8px; margin-bottom: 8px; background: #2b313a; border: 1px solid #474d57; border-radius: 4px; color: white; }
    
    .history { background: #1e2329; border-radius: 8px; padding: 15px; }
    .history-item { font-size: 13px; color: #848e9c; padding: 5px 0; border-bottom: 1px solid #2b313a; }
  </style>
</head>
<body>

<div class="container">
  <h1>Crypto Trading Dashboard</h1>

  <div class="dashboard">
    <div class="card">
      <h3>USDT Demo Balance</h3>
      <div class="balance" id="usdt-balance">10000.00 $</div>
      <input type="number" id="amount-input" placeholder="თანხა (USDT)">
      <div class="actions">
        <button class="btn-green" onclick="deposit()">დეპოზიტი</button>
        <button class="btn-blue" onclick="transfer()">გადარიცხვა</button>
      </div>
    </div>

    <div class="card">
      <h3>სწრაფი თრეიდინგი (BTC)</h3>
      <p id="selected-btc-price">ფასი იტვირთება...</p>
      <div class="actions" style="margin-top: 30px;">
        <button class="btn-green" onclick="trade('BUY')">ყიდვა (BTC)</button>
        <button class="btn-red" onclick="trade('SELL')">გაყიდვა (BTC)</button>
      </div>
    </div>
  </div>

  <div class="prices-list">
    <h3>კრიპტოვალუტის ფასები (Live API)</h3>
    <div class="crypto-row"><span>Bitcoin (BTC)</span><strong id="btc-price">$0.00</strong></div>
    <div class="crypto-row"><span>Ethereum (ETH)</span><strong id="eth-price">$0.00</strong></div>
    <div class="crypto-row"><span>Solana (SOL)</span><strong id="sol-price">$0.00</strong></div>
  </div>

  <div class="history">
    <h3>ტრანზაქციების ისტორია</h3>
    <div id="history-log"></div>
  </div>
</div>

<script>
  let balance = 10000;
  let btcPrice = 0;

  async function fetchPrices() {
    try {
      const res = await fetch('https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana&vs_currencies=usd');
      const data = await res.json();
      
      btcPrice = data.bitcoin.usd;
      document.getElementById('btc-price').innerText = '$' + btcPrice;
      document.getElementById('selected-btc-price').innerText = '1 BTC = $' + btcPrice;
      document.getElementById('eth-price').innerText = '$' + data.ethereum.usd;
      document.getElementById('sol-price').innerText = '$' + data.solana.usd;
    } catch (err) {
      console.log('API Error:', err);
    }
  }

  function deposit() {
    const val = parseFloat(document.getElementById('amount-input').value);
    if (!val || val <= 0) return alert('ჩაწერეთ სწორი თანხა');
    balance += val;
    updateBalance();
    addHistory(`დეპოზიტი: +${val} USDT`);
  }

  function transfer() {
    const val = parseFloat(document.getElementById('amount-input').value);
    if (!val || val > balance) return alert('არასაკმარისი ბალანსი');
    balance -= val;
    updateBalance();
    addHistory(`გადარიცხვა: -${val} USDT`);
  }

  function trade(type) {
    const val = parseFloat(document.getElementById('amount-input').value);
    if (!val || val <= 0) return alert('ჩაწერეთ თანხა');
    if (type === 'BUY' && val > balance) return alert('არასაკმარისი ბალანსი');

    if (type === 'BUY') {
      balance -= val;
      addHistory(`BTC ყიდვა: ${val} USDT`);
    } else {
      balance += val;
      addHistory(`BTC გაყიდვა: +${val} USDT`);
    }
    updateBalance();
  }

  function updateBalance() {
    document.getElementById('usdt-balance').innerText = balance.toFixed(2) + ' $';
    document.getElementById('amount-input').value = '';
  }

  function addHistory(text) {
    const log = document.getElementById('history-log');
    const item = document.createElement('div');
    item.className = 'history-item';
    item.innerText = `${new Date().toLocaleTimeString()} - ${text}`;
    log.prepend(item);
  }

  fetchPrices();
  setInterval(fetchPrices, 15000); // 15 წამში ერთხელ ანახლებს ფასებს
</script>

</body>
</html>
