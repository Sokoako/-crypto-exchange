/* =====================================================
   SELECT TRADE
===================================================== */

function selectTrade(id){

    document.getElementById("tradeSelect")
        .value=id;

    showPage("trade");

    updateTrade();

}


/* =====================================================
   TRADE UI
===================================================== */

function updateTrade(){

    const id =
        document.getElementById("tradeSelect")
        .value;

    const data =
        prices[id];

    if(!data)
        return;


    const coin =
        coins[id];


    document.getElementById("chartCoin")
        .innerText=coin.name;


    document.getElementById("tradePrice")
        .innerText=coinPrice(data.usd);


    const change =
        data.usd_24h_change || 0;


    const changeEl =
        document.getElementById("tradeChange");


    changeEl.innerText =
        (change>=0?"+":"")
        +
        change.toFixed(2)
        +
        "%";


    changeEl.className =
        change>=0
        ? "green"
        : "red";


    historyPrices.push(data.usd);


    if(historyPrices.length>40)
        historyPrices.shift();


    drawChart();

}


document
    .getElementById("tradeSelect")
    .addEventListener(
        "change",
        updateTrade
    );


/* =====================================================
   CHART
===================================================== */

function drawChart(){

    const canvas =
        document.getElementById("priceChart");

    if(!canvas)
        return;


    const ctx =
        canvas.getContext("2d");


    const width =
        canvas.clientWidth * 2;

    const height =
        canvas.clientHeight * 2;


    canvas.width=width;
    canvas.height=height;


    ctx.clearRect(
        0,
        0,
        width,
        height
    );


    if(historyPrices.length<2)
        return;


    const min =
        Math.min(...historyPrices);

    const max =
        Math.max(...historyPrices);


    const range =
        max-min || 1;


    ctx.beginPath();


    historyPrices.forEach(
        (price,index)=>{

            const x =
                index *
                width /
                (historyPrices.length-1);


            const y =
                height -
                (
                    (price-min)
                    /
                    range
                )
                *
                (height-40)
                -
                20;


            if(index===0)
                ctx.moveTo(x,y);
            else
                ctx.lineTo(x,y);

        }
    );


    ctx.strokeStyle="#20b8ff";
    ctx.lineWidth=5;

    ctx.stroke();

}


/* =====================================================
   BUY
===================================================== */

function buy(){

    const id =
        document.getElementById("tradeSelect")
        .value;

    const amount =
        Number(
            document.getElementById("tradeAmount")
            .value
        );


    const price =
        prices[id]?.usd;


    if(!amount || amount<=0){

        showToast(
            "Enter a valid amount"
        );

        return;

    }


    if(!price){

        showToast(
            "Price unavailable"
        );

        return;

    }


    if(amount>balance){

        showToast(
            "Not enough demo USD"
        );

        return;

    }


    const quantity =
        amount/price;


    balance-=amount;

    holdings[id]+=quantity;


    transactions.unshift({

        type:"BUY",

        coin:id,

        amount:amount,

        quantity:quantity,

        time:new Date()
        .toLocaleString()

    });


    save();

    updateAll();


    showToast(
        "BUY completed successfully 🚀"
    );

}


/* =====================================================
   SELL
===================================================== */

function sell(){

    const id =
        document.getElementById("tradeSelect")
        .value;

    const amount =
        Number(
            document.getElementById("tradeAmount")
            .value
        );


    const price =
        prices[id]?.usd;


    if(!amount || amount<=0){

        showToast(
            "Enter a valid amount"
        );

        return;

    }


    if(!price){

        showToast(
            "Price unavailable"
        );

        return;

    }


    const quantity =
        amount/price;


    if(holdings[id]<quantity){

        showToast(
            "Not enough crypto"
        );

        return;

    }


    holdings[id]-=quantity;

    balance+=amount;


    transactions.unshift({

        type:"SELL",

        coin:id,

        amount:amount,

        quantity:quantity,

        time:new Date()
        .toLocaleString()

    });


    save();

    updateAll();


    showToast(
        "SELL completed successfully"
    );

}


/* =====================================================
   WALLET
===================================================== */

function updateWallet(){

    document.getElementById("headerBalance")
        .innerText=money(balance);


    document.getElementById("statBalance")
        .innerText=money(balance);


    document.getElementById("walletBalance")
        .innerText=money(balance);


    let cryptoValue=0;


    Object.keys(coins)
    .forEach(id=>{

        if(prices[id]){

            cryptoValue +=
                holdings[id] *
                prices[id].usd;

        }

    });


    const total =
        balance+cryptoValue;


    document.getElementById("portfolioValue")
        .innerText=money(total);


    document.getElementById("walletPortfolio")
        .innerText=money(total);


    const profit =
        total-10000;


    const profitEl =
        document.getElementById("profitLoss");


    profitEl.innerText =
        (profit>=0?"+":"")
        +
        "$"
        +
        money(profit);


    profitEl.className =
        "stat-value "
        +
        (
            profit>=0
            ? "green"
            : "red"
        );


    const list =
        document.getElementById("assetsList");


    list.innerHTML="";


    Object.entries(coins)
    .forEach(([id,c])=>{

        const quantity =
            holdings[id] || 0;


        const value =
            prices[id]
            ? quantity*prices[id].usd
            : 0;


        const div =
            document.createElement("div");


        div.className="asset";


        div.innerHTML=`

            <div class="asset-left">

                <div class="coin-icon">
                    ${c.icon}
                </div>

                <div>

                    <b>${c.name}</b>

                    <div class="muted">
                        ${quantity.toFixed(6)}
                        ${c.symbol}
                    </div>

                </div>

            </div>


            <b>
                $${money(value)}
            </b>

        `;


        list.appendChild(div);

    });

}


/* =====================================================
   HISTORY
===================================================== */

function updateHistory(){

    const list =
        document.getElementById("historyList");


    list.innerHTML="";


    if(transactions.length===0){

        list.innerHTML=`

            <p class="muted">
                No transactions yet.
            </p>

        `;

        return;

    }


    transactions
    .slice(0,30)
    .forEach(t=>{

        const coin =
            coins[t.coin];


        const row =
            document.createElement("div");


        row.className="history-row";


        row.innerHTML=`

            <span class="${
                t.type==="BUY"
                ?"green"
                :"red"
            }">

                ${t.type}

            </span>


            <span>
                ${coin.symbol}
            </span>


            <span>
                $${money(t.amount)}
            </span>

        `;


        list.appendChild(row);

    });

}


